<Window x:Class="OpenLMStudio.Desktop.VMWizardWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:qemu="clr-namespace:OpenLMStudio.Domain.Models.QEMU;assembly=OpenLMStudio.Domain"
    Title="Create Virtual Machine"
    Width="600" Height="550"
    MinWidth="550" MinHeight="450"
    WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <qemu:VMCreationForm/>
    </Design.DataContext>

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="New Virtual Machine"
                       FontSize="22"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Configure your virtual machine settings"
                       FontSize="13"
                       Foreground="#888"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Wizard Content Area -->
        <Border Grid.Row="1"
                Background="#F5F5F5"
                CornerRadius="8"
                Padding="24"
                Margin="0,0,0,16">
            <ScrollViewer>
                <ContentControl x:Name="WizardContent"/>
            </ScrollViewer>
        </Border>

        <!-- Footer with Navigation -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    HorizontalAlignment="Right"
                    Margin="0,0,8,0"
                    Padding="16,8"/>
            <Button x:Name="PrevButton"
                    Content="Previous"
                    HorizontalAlignment="Right"
                    Margin="0,0,8,0"
                    Padding="16,8"
                    IsVisible="False"/>
            <Button x:Name="NextButton"
                    Content="Next"
                    HorizontalAlignment="Right"
                    Padding="16,8"/>
            <Button x:Name="CreateButton"
                    Content="Create"
                    HorizontalAlignment="Right"
                    Padding="16,8"
                    IsVisible="False"/>
        </StackPanel>
    </Grid>
</Window>