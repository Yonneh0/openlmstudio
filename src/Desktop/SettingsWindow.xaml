<Window x:Class="OpenLMStudio.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - OpenLMStudio"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <!-- Dark theme resources -->
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        
        <!-- Tab style -->
        <Style x:Key="SettingsTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SettingsTabButtonActive" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Setting item style -->
        <Style x:Key="SettingItem" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <!-- Label style -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Description style -->
        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <!-- Input style -->
        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
        </Style>

        <!-- Save button style -->
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Cancel button style -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
        </Style>

        <!-- Toggle style -->
        <Style x:Key="SettingToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <!-- Tab bar -->
            <RowDefinition Height="Auto"/>
            <!-- Settings content -->
            <RowDefinition Height="*"/>
            <!-- Buttons row -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab navigation (using RadioButton for Windows App SDK compatibility) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <RadioButton x:Name="ServerTabButton" 
                         Content="Server"
                         Style="{StaticResource SettingsTabButtonActive}"
                         Tag="Server"
                         Checked="OnTabChanged"/>
            
            <RadioButton x:Name="ModelTabButton"
                         Content="Model"
                         Style="{StaticResource SettingsTabButton}"
                         Tag="Model"
                         Checked="OnTabChanged"/>
            
            <RadioButton x:Name="AgentTabButton"
                         Content="Agent"
                         Style="{StaticResource SettingsTabButton}"
                         Tag="Agent"
                         Checked="OnTabChanged"/>
        </StackPanel>

        <!-- Settings content panels -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ShowGridLines="False">
                <!-- Server settings panel -->
                <StackPanel x:Name="ServerSettingsPanel">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="Server Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                    </Border>

                    <!-- Port setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Server Port"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="The port the local API server will listen on. Default: 8080"/>
                        <TextBox x:Name="PortSettingInput" Style="{StaticResource SettingInput}">
                            <TextBox.Text>8080</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <!-- HTTPS setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Enable HTTPS"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Use HTTPS for the local server (generates self-signed certificate automatically)"/>
                        <CheckBox x:Name="HttpsEnabledCheckbox" Style="{StaticResource SettingToggle}">
                            <CheckBox.Content>Enable HTTPS</CheckBox.Content>
                        </CheckBox>
                    </StackPanel>

                    <!-- API Key setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="API Key (Optional)"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="If set, clients must include this key in the Authorization header to use the API"/>
                        <TextBox x:Name="ApiKeySettingInput" Style="{StaticResource SettingInput}"/>
                    </StackPanel>

                    <!-- Rate Limiting setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Rate Limiting (Requests/Minute)"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Maximum number of requests per minute from a single client. 0 = no limit."/>
                        <TextBox x:Name="RateLimitSettingInput" Style="{StaticResource SettingInput}">
                            <TextBox.Text>60</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <!-- Context Length setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Context Length (Tokens)"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Maximum number of tokens for the context window. Default: 4096."/>
                        <TextBox x:Name="ContextLengthSettingInput" Style="{StaticResource SettingInput}">
                            <TextBox.Text>4096</TextBox.Text>
                        </TextBox>
                    </StackPanel>
                </StackPanel>

                <!-- Model settings panel -->
                <StackPanel x:Name="ModelSettingsPanel" Visibility="Collapsed">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="Model Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                    </Border>

                    <!-- Default model setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Model"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Model to use when no explicit model is selected."/>
                        <ComboBox x:Name="DefaultModelSelector" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <ComboBoxItem Content="Not Selected"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Offload setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="GPU Layer Offloading (n-gpu-layers)"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Number of layers to offload to GPU. 0 = CPU only. -1 = auto-detect."/>
                        <Slider x:Name="GpuOffloadSlider" Minimum="-1" Maximum="999" Value="-1" TickFrequency="1"/>
                    </StackPanel>

                    <!-- Context length override -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Context Length Override"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Override the default context window size. Leave empty to use model's native context."/>
                        <TextBox x:Name="ContextLengthOverrideInput" Style="{StaticResource SettingInput}"/>
                    </StackPanel>

                    <!-- Temperature setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Temperature"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Controls randomness in responses. Higher = more creative, lower = more deterministic."/>
                        <Slider x:Name="TemperatureSlider" Minimum="0" Maximum="2" Value="0.7" TickFrequency="0.1"/>
                    </StackPanel>

                    <!-- Top-P setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Top-P"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Nucleus sampling parameter. Controls diversity by only considering tokens with cumulative probability >= top_p."/>
                        <Slider x:Name="TopPValueSlider" Minimum="0" Maximum="1" Value="1.0" TickFrequency="0.05"/>
                    </StackPanel>

                    <!-- Max Tokens setting -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Max Tokens"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Maximum number of tokens to generate in responses. 0 = no limit."/>
                        <TextBox x:Name="MaxTokensSettingInput" Style="{StaticResource SettingInput}">
                            <TextBox.Text>4096</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <!-- Image generation defaults -->
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                        <TextBlock Text="Image Generation Defaults" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                    </Border>

                    <!-- Image resolution -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Resolution"/>
                        <ComboBox x:Name="ImageResSettingInput" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <ComboBoxItem Content="512x512"/>
                            <ComboBoxItem Content="768x768"/>
                            <ComboBoxItem Content="1024x1024" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Image steps -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Steps"/>
                        <Slider x:Name="ImageStepsSettingSlider" Minimum="1" Maximum="100" Value="30" TickFrequency="1"/>
                    </StackPanel>

                    <!-- Image CFG scale -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default CFG Scale"/>
                        <Slider x:Name="ImageCfgSettingSlider" Minimum="1.0" Maximum="20.0" Value="7.5" TickFrequency="0.5"/>
                    </StackPanel>

                    <!-- Compression default -->
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                        <TextBlock Text="Context Compression Defaults" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                    </Border>

                    <!-- Default compression -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Compression Strategy"/>
                        <ComboBox x:Name="CompressionStrategyInput" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Light" IsSelected="True"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="Aggressive"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Token budget -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Token Budget (per chat)"/>
                        <TextBox x:Name="TokenBudgetInput" Style="{StaticResource SettingInput}">
                            <TextBox.Text>4096</TextBox.Text>
                        </TextBox>
                    </StackPanel>
                </StackPanel>

                <!-- Agent settings panel -->
                <StackPanel x:Name="AgentSettingsPanel" Visibility="Collapsed">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="Agent Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                    </Border>

                    <!-- Iteration limit -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Max Agent Iterations"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Maximum number of iterations an agent task can run before being stopped."/>
                        <TextBox x:Name="AgentIterationLimitInput" Style="{StaticResource SettingInput}">
                            <TextBox.Text>50</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <!-- Auto-commit threshold -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Auto-Commit File Threshold (KB)"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Files smaller than this size will be auto-committed without user review."/>
                        <TextBox x:Name="AgentAutoCommitSizeInput" Style="{StaticResource SettingInput}">
                            <TextBox.Text>1024</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <!-- Plan approval -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Require Plan Approval for Risky Operations"/>
                        <CheckBox x:Name="AgentPlanApprovalCheckbox" Style="{StaticResource SettingToggle}">
                            <CheckBox.Content>Require approval before executing risky operations (file writes, commands)</CheckBox.Content>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>

                <!-- Data privacy panel -->
                <StackPanel x:Name="DataPrivacyPanel" Visibility="Collapsed">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock><Run>Data</Run><Run>Privacy&#x26;</Run><Run> Storage</Run></TextBlock>
                    </Border>

                    <!-- Conversation encryption -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Encrypt Conversations at Rest"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="AES-256 encrypt all conversation data stored on disk. Requires a master password."/>
                        <CheckBox x:Name="EncryptionEnabledCheckbox" Style="{StaticResource SettingToggle}">
                            <CheckBox.Content>Enable encryption</CheckBox.Content>
                        </CheckBox>
                    </StackPanel>

                    <!-- Export format -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Default Conversation Export Format"/>
                        <ComboBox x:Name="ExportFormatInput" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <ComboBoxItem Content="JSON" IsSelected="True"/>
                            <ComboBoxItem Content="Markdown"/>
                            <ComboBoxItem Content="HTML"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Model cache cleanup -->
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                        <TextBlock Text="Model Cache Cleanup" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                    </Border>

                    <!-- Retention policy -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Least Recently Used Model Cache Timeout (days)"/>
                        <TextBlock Style="{StaticResource SettingDescription}" 
                                   Text="Models not used within this period may be unloaded to free memory."/>
                        <TextBox x:Name="CacheTimeoutInput" Style="{StaticResource SettingInput}">
                            <TextBox.Text>30</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <!-- Auto-cleanup -->
                    <StackPanel Style="{StaticResource SettingItem}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Auto-Cleanup Orphaned Model Files"/>
                        <CheckBox x:Name="AutoCleanupCheckbox" Style="{StaticResource SettingToggle}">
                            <CheckBox.Content>Delete model files that are no longer in the registry</CheckBox.Content>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Buttons row -->
        <Border Grid.Row="2" Background="{StaticResource BgPrimary}" Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Style="{StaticResource CancelButton}"
                        Margin="0,0,8,0"
                        Width="100"/>
                <Button x:Name="SaveSettingsBtn"
                        Content="Save"
                        Style="{StaticResource SaveButton}"
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>