<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenLMStudio.Desktop</RootNamespace>

    <!-- Default runtime: Windows x64 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- All supported runtimes (platforms) -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>

    <!-- Publish as a single self-contained executable -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TrimMode>none</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Output to root folder so OpenLMStudio.exe is at project root -->
    <OutputPath>..\..\</OutputPath>
    <PublishDir>..\..\</PublishDir>

    <!-- Output binary name -->
    <AssemblyName>OpenLMStudio</AssemblyName>

    <!-- Suppress Avalonia AVLN3001: known false positive when using DI constructor -->
    <NoWarn>AVLN3001;$(NoWarn)</NoWarn>
  </PropertyGroup>

  <!-- Avalonia UI packages for cross-platform support -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <!-- Conditional compilation for Windows-only Avalonia features -->
    <PackageReference Condition="$([MSBuild]::IsOsPlatform(Windows))" 
                      Include="Avalonia.Win32" Version="11.2.5" />
    <!-- Conditional for macOS -->
    <PackageReference Condition="$([MSBuild]::IsOsPlatform(OSX))" 
                      Include="Avalonia.MacOS" Version="11.2.5" />
  </ItemGroup>

  <!-- DI support for Avalonia apps -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.2.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- Project references remain the same -->
  <ItemGroup>
    <ProjectReference Include="..\Domain\OpenLMStudio.Domain.csproj" />
    <ProjectReference Include="..\Application\OpenLMStudio.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\OpenLMStudio.Infrastructure.csproj" />
  </ItemGroup>

</Project>
