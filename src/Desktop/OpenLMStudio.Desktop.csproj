<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenLMStudio.Desktop</RootNamespace>

    <!-- Default runtime: Windows x64 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- All supported runtimes (platforms) -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>

    <!-- Publish as a single self-contained executable -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TrimMode>none</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Output to root folder so OpenLMStudio.exe is at project root -->
    <OutputPath>..\..\</OutputPath>
    <PublishDir>..\..\</PublishDir>

    <!-- Output binary name -->
    <AssemblyName>OpenLMStudio</AssemblyName>

    <!-- Suppress Avalonia AVLN3001: known false positive when using DI constructor -->
    <NoWarn>AVLN3001;NU1701;$(NoWarn)</NoWarn>
  </PropertyGroup>

  <!-- Git commit metadata — captured at build time and written to GeneratedGitInfo.cs -->
  <Target Name="GenerateGitInfo" BeforeTargets="CoreCompile" Outputs="GeneratedGitInfo.cs">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output PropertyName="GitCommit" TaskParameter="ConsoleOutput" />
    </Exec>
    <Exec Command="git rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output PropertyName="GitBranch" TaskParameter="ConsoleOutput" />
    </Exec>
    <Exec Command="git diff --quiet 2>NUL" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output PropertyName="GitDirty" TaskParameter="ExitCode" />
    </Exec>
    <Exec Command="git log -7 --oneline --date=short --format=&quot;%h %ad %s&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output PropertyName="GitLog" TaskParameter="ConsoleOutput" />
    </Exec>
    <PropertyGroup>
      <GitCommit>$([System.String]::new($(GitCommit)).Trim())</GitCommit>
      <GitBranch>$([System.String]::new($(GitBranch)).Trim())</GitBranch>
      <GitDirty>$([System.String]::new($(GitDirty)).Trim())</GitDirty>
      <GitLog>$([System.String]::new($(GitLog)).Trim())</GitLog>
    </PropertyGroup>
    <WriteLinesToFile File="GeneratedGitInfo.cs" Lines='namespace OpenLMStudio.Desktop { internal static class GitInfo {
    public const string Commit = "$(GitCommit)"%3B
    public const string Branch = "$(GitBranch)"%3B
    public const string Dirty = "$(GitDirty)"%3B
    public const string FullName = "$(GitCommit)"%3B
    public const string FullBranch = "$(GitBranch)"%3B
    public const string Log = "$(GitLog)"%3B
}}' Overwrite="true" Encoding="Unicode" />
  </Target>

  <!-- Avalonia UI packages for cross-platform support -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <!-- Conditional compilation for Windows-only Avalonia features -->
    <PackageReference Condition="$([MSBuild]::IsOsPlatform(Windows))" 
                      Include="Avalonia.Win32" Version="12.0.3" />
    <!-- Conditional for macOS -->
    <PackageReference Condition="$([MSBuild]::IsOsPlatform(OSX))" 
                      Include="Avalonia.MacOS" Version="12.0.3" />
  </ItemGroup>

  <!-- DI support for Avalonia apps -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.3.0.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- SkiaSharp for 2D rendering (match Avalonia.Desktop's transitive version) -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4-preview.1.1" />
  </ItemGroup>

  <!-- Global usings for Avalonia types -->
  <ItemGroup>
    <Using Include="Avalonia.Interactivity" />
    <Using Include="Avalonia.Controls" />
    <Using Include="Avalonia.Controls.Primitives" />
    <Using Include="Avalonia.Input" />
    <Using Include="Avalonia.Media" />
    <Using Include="Avalonia.Layout" />
    <Using Include="Avalonia.Platform.Storage" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.IO" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Text" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <!-- Project references remain the same -->
  <ItemGroup>
    <ProjectReference Include="..\Domain\OpenLMStudio.Domain.csproj" />
    <ProjectReference Include="..\Application\OpenLMStudio.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\OpenLMStudio.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Avalonia resources for VM wizard -->
  <ItemGroup>
    <AvaloniaResource Remove="Controls\VMConsole.axaml" />
    <AvaloniaResource Remove="Windows\VMWizardWindow.axaml" />
  </ItemGroup>

</Project>