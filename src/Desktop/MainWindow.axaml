<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenLMStudio.Desktop.MainWindow"
        Width="1400" Height="750"
        MinWidth="1000" MinHeight="600">

    <Window.Resources>
        <!-- Color constants as SolidColorBrush resources for StaticResource binding -->
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="TextMuted" Color="#666666"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9800"/>
        <SolidColorBrush x:Key="SendButtonColor" Color="#0E639C"/>
    </Window.Resources>

    <!-- Avalonia Style selectors for styling controls by class/type -->
    <Window.Styles>
        <!-- Button styles -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Background" Value="{StaticResource SendButtonColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Tab style for left sidebar -->
        <Style Selector="ToggleButton.tab">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Chat item style -->
        <Style Selector="Button.chatItem">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Message bubble styles -->
        <Style Selector="Border.userMessage">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="CornerRadius" Value="8,0,8,8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,4,8"/>
        </Style>

        <Style Selector="Border.assistantMessage">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="CornerRadius" Value="0,8,8,8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <!-- Status indicator -->
        <Style Selector="Ellipse.statusDot">
            <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,2,6,0"/>
        </Style>

        <!-- Input area style -->
        <Style Selector="Border.inputArea">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Search bar style -->
        <Style Selector="Border.searchBar">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- ToggleButton for tool tabs -->
        <Style Selector="ToggleButton.toolTab">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Settings tab style -->
        <Style Selector="RadioButton.settingsTab">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="RadioButton.settingsTab:checked">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
        </Style>

        <!-- Setting item style -->
        <Style Selector="StackPanel.settingItem">
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <!-- Label style for settings -->
        <Style Selector="TextBlock.settingLabel">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Description style for settings -->
        <Style Selector="TextBlock.settingDescription">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <!-- Input style for settings -->
        <Style Selector="TextBox.settingInput">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
        </Style>

        <!-- Save button style for settings -->
        <Style Selector="Button.saveBtn">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Cancel button style for settings -->
        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
        </Style>

        <!-- Toggle checkbox style for settings -->
        <Style Selector="CheckBox.settingToggle">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Styles>

    <!-- Three-panel layout: Left Sidebar | Center Chat | Right Sidebar -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left sidebar: Fixed width for navigation -->
            <ColumnDefinition Width="280"/>
            <!-- Center pane: Flexible width for chat content -->
            <ColumnDefinition Width="4*"/>
            <!-- Right sidebar: Smaller fixed width for settings/monitoring -->
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT SIDEBAR ===== -->
        <Panel Grid.Column="0" Background="{StaticResource BgPrimary}">
            <DockPanel>
                <!-- Header -->
                <TextBlock Text="OpenLMStudio" 
                           FontSize="18" FontWeight="SemiBold" 
                           Foreground="#4FC3F7"
                           Padding="16,16,16,8"
                           DockPanel.Dock="Top"/>

                        <!-- Search bar -->
                        <Border Margin="8,0,8,0">
                            <TextBox x:Name="SearchText"
                                     Foreground="{StaticResource TextPrimary}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="10,6"
                                     FontSize="13"/>
                        </Border>

                <!-- Navigation tabs -->
                <DockPanel Margin="12,12,12,0">
                    <!-- Chat tab content (default) -->
                    <StackPanel x:Name="ChatTabContent" DockPanel.Dock="Top">
                        <!-- Tab title - clickable -->
                        <TextBlock x:Name="_chatTabTitle" Text="Chats" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="8,6" PointerPressed="OnChatTabPointerPressed"/>
                        
                        <!-- Chat list -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatListPanel" Margin="0,4,0,0">
                                <TextBlock Text="No chats loaded" 
                                           Foreground="{StaticResource TextMuted}" 
                                           Padding="12,8"
                                           FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Chat folder navigation -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,16,0,0">
                            <TextBlock Text="Folders" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="8,8"/>
                        </Border>
                    </StackPanel>

                    <!-- Server tab content -->
                    <StackPanel x:Name="ServerTabContent" DockPanel.Dock="Top">
                        <TextBlock x:Name="_serverTabTitle" Text="Server Status" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="8,6" PointerPressed="OnServerTabPointerPressed"/>
                        
                        <!-- Server state indicator -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ServerStatusText" Text="Server: Stopped" Foreground="{StaticResource AccentRed}" Padding="12,8"/>
                                <TextBlock x:Name="ServerPortText" Text="Port: 8080" Padding="12,4"/>
                                <Button x:Name="LeftServerStartStopButton"
                                        Content="Start Server" 
                                        Background="#0E639C"
                                        Foreground="White"
                                        Padding="8,4"
                                        Margin="8,8,8,8"
                                        HorizontalAlignment="Stretch"
                                        Height="36"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Models tab content -->
                    <StackPanel x:Name="ModelsTabContent" DockPanel.Dock="Top">
                        <TextBlock x:Name="_modelsTabTitle" Text="Models" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="8,6" PointerPressed="OnModelsTabPointerPressed"/>
                        
                        <!-- Model list placeholder -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="No models loaded" 
                                           Foreground="{StaticResource TextMuted}" 
                                           Padding="12,8"
                                           FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Add model button -->
                        <Button x:Name="AddModelButton"
                                Content="+ Add Model" 
                                Background="#0E639C"
                                Foreground="White"
                                Padding="8,4"
                                Margin="8,8,8,0"
                                HorizontalAlignment="Stretch"
                                Height="36"/>
                    </StackPanel>

                    <!-- Devices tab content -->
                    <StackPanel x:Name="DevicesTabContent" DockPanel.Dock="Top">
                        <TextBlock x:Name="_devicesTabTitle" Text="Devices" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="8,6" PointerPressed="OnDevicesTabPointerPressed"/>
                        
                        <!-- Device info placeholder -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="GPU: None Detected" Foreground="{StaticResource TextPrimary}" Padding="12,8"/>
                                <TextBlock x:Name="CpuCoreText" Text="CPU Cores: 8" Padding="12,4"/>
                                <TextBlock x:Name="RamInfoText" Text="RAM: 32 GB Available" Padding="12,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Model loading info -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LoadedModelRightText" Text="Loaded Model: None" Foreground="{StaticResource TextPrimary}" Padding="12,8"/>
                                <TextBlock x:Name="ContextLengthRightText" Text="Context: 4096 tokens" Padding="12,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Load model button -->
                        <Button x:Name="LoadModelButton"
                                Content="Load Model" 
                                Background="#0E639C"
                                Foreground="White"
                                Padding="8,4"
                                Margin="8,8,8,0"
                                HorizontalAlignment="Stretch"
                                Height="36"/>
                    </StackPanel>

                    <!-- Image Generation tab content -->
                    <StackPanel x:Name="ImageGenTabContent" DockPanel.Dock="Top">
                        <TextBlock Text="Image Generation" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="8,6" PointerPressed="OnImageGenTabPointerPressed"/>
                        
                        <!-- Model selector -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Select Model:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <ComboBox x:Name="ImageGenModelSelector" 
                                          Foreground="{StaticResource TextPrimary}"
                                          Background="{StaticResource BgTertiary}"
                                          Margin="8,4,8,8"
                                          Height="32"/>
                            </StackPanel>
                        </Border>

                        <!-- Prompt input -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Prompt:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                 <TextBox x:Name="ImageGenPromptInput" 
                                          Foreground="{StaticResource TextPrimary}"
                                          Background="{StaticResource BgTertiary}"
                                          BorderThickness="0"
                                          Margin="8,4,8,8"
                                          Height="60"
                                          AcceptsReturn="True"/>
                                
                                <TextBlock Text="Negative Prompt (optional):" Foreground="{StaticResource TextPrimary}" Padding="12,4,12,2"/>
                                 <TextBox x:Name="ImageGenNegPromptInput" 
                                          Foreground="{StaticResource TextPrimary}"
                                          Background="{StaticResource BgTertiary}"
                                          BorderThickness="0"
                                          Margin="8,4,8,8"
                                          Height="60"
                                          AcceptsReturn="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Parameter controls -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Parameters:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                
                                <!-- Resolution -->
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="Resolution:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="ImageGenResolutionSelector" 
                                              Foreground="{StaticResource TextPrimary}"
                                              Background="{StaticResource BgTertiary}"
                                              Margin="8,0,0,0"
                                              Height="28">
                                        <TextBlock Text="512x512"/>
                                        <TextBlock Text="768x768"/>
                                        <TextBlock Text="1024x1024"/>
                                        <TextBlock Text="1280x720" Foreground="{StaticResource TextPrimary}"/>
                                    </ComboBox>
                                </DockPanel>

                                <!-- Steps -->
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="Steps:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="ImageGenStepsSlider" 
                                            Minimum="1" Maximum="50" Value="20"
                                            Margin="8,0,8,0"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding ElementName=ImageGenStepsSlider, Path=Value, StringFormat={}{0:F0}}" 
                                               Width="30" Foreground="{StaticResource TextSecondary}"/>
                                </DockPanel>

                                <!-- CFG Scale -->
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="CFG:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="ImageGenCfgSlider" 
                                            Minimum="1.0" Maximum="20.0" Value="7.5" IsSnapToTickEnabled="True"
                                            TickFrequency="0.5"
                                            Margin="8,0,8,0"/>
                                    <TextBlock Text="{Binding ElementName=ImageGenCfgSlider, Path=Value, StringFormat={}{0:F1}}" 
                                               Width="35" Foreground="{StaticResource TextSecondary}"/>
                                </DockPanel>

                                <!-- Seed -->
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="Seed:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="ImageGenSeedInput" 
                                             Foreground="{StaticResource TextPrimary}"
                                             Background="{StaticResource BgTertiary}"
                                             BorderThickness="0"
                                             Margin="8,0,0,0"
                                             Width="120"
                                             Height="28"/>
                                     <Button x:Name="RandomSeedButton"
                                             Content="🎲" 
                                             Background="#0E639C"
                                             Foreground="White"
                                             Padding="6,4"
                                             Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Generate button -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                             <Button x:Name="ImageGenGenerateBtn"
                                     Content="Generate Image" 
                                     Background="#4FC3F7"
                                     Foreground="White"
                                     Padding="12,4"
                                     Height="40"
                                     Margin="8"/>
                        </Border>

                        <!-- Progress indicator -->
                        <TextBlock x:Name="ImageGenProgressText" 
                                   Foreground="{StaticResource TextMuted}" 
                                   Padding="12,4"
                                   FontSize="12"/>

                        <!-- Output display area -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Output:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <Border x:Name="ImageGenOutputArea" 
                                        Background="{StaticResource BgTertiary}"
                                        CornerRadius="4"
                                        Margin="8,4,8,8">
                                    <TextBlock Text="Generated image will appear here" 
                                               Foreground="{StaticResource TextMuted}"
                                               Padding="20"
                                               FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Batch generation section -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Batch Generation:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="Count:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="ImageGenBatchSizeSlider" 
                                            Minimum="1" Maximum="16" Value="1"
                                            Margin="8,0,8,0"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding ElementName=ImageGenBatchSizeSlider, Path=Value, StringFormat={}{0:F0}}" 
                                               Width="30" Foreground="{StaticResource TextSecondary}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- LoRA Adapter section -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="LoRA Adapters:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <ComboBox x:Name="ImageGenLoraSelector" 
                                          Foreground="{StaticResource TextPrimary}"
                                          Background="{StaticResource BgTertiary}"
                                          Margin="8,4,8,0"
                                          Height="32"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                 <!-- Bottom section - New Chat button -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="12,0,12,8">
                    <Button x:Name="NewChatButton"
                            Content="+ New Chat" 
                            Background="#0E639C"
                            Foreground="White"
                            Padding="8,4"
                            Height="36"/>
                </Border>

                <!-- Settings button -->
                <Button x:Name="SettingsButton"
                        Content="⚙️" 
                        DockPanel.Dock="Bottom"
                        Height="36"
                        Margin="12,8,12,12"
                        HorizontalAlignment="Stretch"
                        Background="#252529"
                        Foreground="{StaticResource TextPrimary}"/>
            </DockPanel>
        </Panel>

        <!-- ===== CENTER PANE (Chat Interface) ===== -->
        <Panel Grid.Column="1" Background="#1A1A1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat header with model selector -->
                <Border Grid.Row="0" Background="{StaticResource BgSecondary}">
                    <StackPanel Orientation="Horizontal" Margin="16,12">
                        <TextBlock x:Name="ChatTitleText" Text="Chat Session" FontWeight="SemiBold"/>
                        
                        <!-- Model selector -->
                        <Border Background="#333338" CornerRadius="4" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Model: " Padding="12,6,4,6"/>
                                <TextBlock x:Name="SelectedModelText" Text="Not Selected" Padding="4,6,12,6"/>
                            </StackPanel>
                        </Border>

                        <!-- Token count -->
                        <Border Background="#333338" CornerRadius="4" Margin="16,0,0,0">
                            <TextBlock x:Name="TokenCountText" Text="Tokens: 0" Padding="12,6"/>
                        </Border>

                        <!-- Streaming indicator -->
                        <Border Background="#333338" CornerRadius="4" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" x:Name="StreamingIndicator">
                                <Ellipse x:Name="StreamingIndicatorDot" 
                                         Width="10" Height="10" Fill="{StaticResource AccentGreen}" Margin="0,2,6,0"/>
                                <TextBlock Text="Streaming" Padding="4,6" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Message display area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessageDisplayPanel" Margin="24,24,24,0">
                        <!-- Welcome message placeholder -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <TextBlock Text="Welcome to OpenLMStudio! Select a model and start chatting." 
                                       Foreground="#AAAAAA" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input area at bottom -->
                <Border Grid.Row="2" Background="{StaticResource BgSecondary}">
                    <Grid Margin="0,8,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Text input -->
                        <Border Grid.Row="0" Background="{StaticResource BgTertiary}" Margin="16,0,16,8">
                            <TextBox x:Name="MessageInputBox"
                                     Foreground="{StaticResource TextPrimary}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,12"
                                     FontSize="14"/>
                        </Border>

                         <!-- Tool tabs -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
                            <ToggleButton x:Name="CodeInterpreterToggle" Content="Code Interpreter" 
                                          Background="#2D2D30"
                                          Foreground="{StaticResource TextPrimary}"
                                          Padding="12,6"/>
                             <TextBlock Text="" Foreground="#CCCCCC" FontSize="12" Padding="4,6"/>
                            <ToggleButton x:Name="ProjectManagementToggle" Content="Project Management" 
                                          Background="#2D2D30"
                                          Foreground="{StaticResource TextPrimary}"
                                          Padding="12,6"/>
                        </StackPanel>

                        <!-- Send button overlay -->
                        <Button x:Name="SendButton"
                                Content="Send" 
                                Grid.RowSpan="3"
                                Width="60" Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="16,0,16,8"
                                Background="{StaticResource AccentBlue}"
                                Foreground="White"/>
                    </Grid>
                </Border>
            </Grid>
        </Panel>

        <!-- ===== RIGHT SIDEBAR (Server/Device Status) ===== -->
        <Panel Grid.Column="2" Background="{StaticResource BgPrimary}">
            <DockPanel Margin="12">
                <!-- Server status section -->
                <TextBlock Text="Server" 
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#4FC3F7"
                           DockPanel.Dock="Top"/>

                <Border Background="{StaticResource BgSecondary}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ServerStatusRight" Text="Server: Stopped" 
                                   Foreground="{StaticResource AccentRed}" Padding="12,8"/>
                        <TextBlock x:Name="ServerPortRightText" Text="Port: 8080" Padding="12,4"/>
                    </StackPanel>
                </Border>

                <!-- Device info section -->
                <TextBlock Text="Devices" 
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#4FC3F7"
                           Margin="0,16,0,0"/>

                <Border Background="{StaticResource BgSecondary}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="GPU: None Detected" 
                                   Foreground="{StaticResource TextPrimary}" Padding="12,8"/>
                        <TextBlock x:Name="CpuCoreRightText" Text="CPU Cores: 8" Padding="12,4"/>
                        <TextBlock x:Name="RamInfoRightText" Text="RAM: 32 GB Available" Padding="12,4"/>
                    </StackPanel>
                </Border>

                <!-- Model info section -->
                <TextBlock Text="Model" 
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#4FC3F7"
                           Margin="0,16,0,0"/>

                <Border Background="{StaticResource BgSecondary}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LoadedModelRightText2" Text="Loaded Model: None" 
                                   Foreground="{StaticResource TextPrimary}" Padding="12,8"/>
                        <TextBlock x:Name="ContextLengthRightText2" Text="Context: 4096 tokens" Padding="12,4"/>
                    </StackPanel>
                </Border>

                <!-- Start/Stop server button -->
                <Button x:Name="RightServerStartStopButton"
                        Content="Start Server" 
                        DockPanel.Dock="Bottom"
                        Height="36"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"/>
            </DockPanel>
        </Panel>
    </Grid>
</Window>