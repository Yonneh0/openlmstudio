<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenLMStudio.Desktop.MainWindow"
        xmlns:Controls="clr-namespace:OpenLMStudio.Desktop.Controls"
        xmlns:local="clr-namespace:OpenLMStudio.Desktop"
         Width="1600" Height="900"
         MinWidth="1300" MinHeight="700">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="TextMuted" Color="#666666"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9800"/>
        <SolidColorBrush x:Key="SendButtonColor" Color="#0E639C"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.accent"><Setter Property="Background" Value="{StaticResource AccentBlue}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,4"/></Style>
        <Style Selector="Button.action"><Setter Property="Background" Value="{StaticResource SendButtonColor}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8,4"/></Style>
        <Style Selector="ToggleButton.tab"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="12,6"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style Selector="Button.chatItem"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="13"/></Style>
        <Style Selector="Border.userMessage"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="CornerRadius" Value="8,0,8,8"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,4,8"/></Style>
        <Style Selector="Border.assistantMessage"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="CornerRadius" Value="0,8,8,8"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="4,0,0,8"/></Style>
        <Style Selector="Ellipse.statusDot"><Setter Property="Fill" Value="{StaticResource AccentRed}"/><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="Margin" Value="0,2,6,0"/></Style>
        <Style Selector="Border.inputArea"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="12"/></Style>
        <Style Selector="Border.searchBar"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,6"/></Style>
        <Style Selector="ToggleButton.toolTab"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="2,1"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FontSize" Value="11"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Height" Value="24"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style Selector="ToggleButton.toolTab:checked"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="Foreground" Value="{StaticResource AccentBlue}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/></Style>
        <Style Selector="ToggleButton.toolTab:hover"><Setter Property="Background" Value="#3A3A3E"/></Style>
        <Style Selector="Button.AgentModeToggle">
            <Setter Property="Background" Value="#2D2D30"/>
        </Style>
        <Style Selector="Button.settingsTab">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- VS Code-style TabStrip tabs (left sidebar) -->
        <Style Selector="ToggleButton.vscodeTab">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.vscodeTab:checked">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
        </Style>
        <Style Selector="ToggleButton.vscodeTab:pointerover">
            <Setter Property="Background" Value="#3A3A3E"/>
        </Style>
        <!-- VS Code-style nested TabStrip tabs (settings sub-tabs) -->
        <Style Selector="TabItem.settingsSubTab">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TabItem.settingsSubTab:selected">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
        </Style>
        <Style Selector="TabItem.settingsSubTab:pointerover">
            <Setter Property="Background" Value="#3A3A3E"/>
        </Style>
        <Style Selector="Button.AgentModeToggle.off">
            <Setter Property="Background" Value="#2D2D30"/>
        </Style>
        <Style Selector="Button.AgentModeToggle.active">
            <Setter Property="Background" Value="#4FC3F7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.AgentModeToggle:hover">
            <Setter Property="Background" Value="#3A3A3E"/>
        </Style>
        <Style Selector="Button.AgentModeToggle.active:hover">
            <Setter Property="Background" Value="#1E88E5"/>
        </Style>
        <Style Selector="Button.AgentModeToggle:pressed">
            <Setter Property="Background" Value="#1E88E5"/>
        </Style>
        <Style Selector="Button.AgentModeToggle.active:pressed">
            <Setter Property="Background" Value="#0D47A1"/>
        </Style>
        <Style Selector="ToggleButton.rightPanelTab"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="CornerRadius" Value="4"/></Style>
        <Style Selector="ToggleButton.rightPanelTab:checked"><Setter Property="Background" Value="{StaticResource AccentBlue}"/><Setter Property="Foreground" Value="White"/></Style>
        <Style Selector="TabItem.toolTab"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2,1"/><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="MaxHeight" Value="24"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style Selector="TabItem.toolTab:selected"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/><Setter Property="Foreground" Value="{StaticResource AccentBlue}"/></Style>
        <Style Selector="TabItem.toolTab:hover"><Setter Property="Background" Value="#3A3A3E"/></Style>
        <Style Selector="RadioButton.settingsTab"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="16,8"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="FontSize" Value="13"/></Style>
        <Style Selector="RadioButton.settingsTab:checked"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="Foreground" Value="{StaticResource AccentBlue}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/></Style>
        <Style Selector="StackPanel.settingItem"><Setter Property="Margin" Value="0,4,0,12"/></Style>
        <Style Selector="TextBlock.settingLabel"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
        <Style Selector="TextBlock.settingDescription"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
        <Style Selector="TextBox.settingInput"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3A3A3E"/></Style>
        <Style Selector="Button.saveBtn"><Setter Property="Background" Value="{StaticResource AccentBlue}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/></Style>
        <Style Selector="Button.cancelBtn"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="16,8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3A3A3E"/></Style>
        <Style Selector="CheckBox.settingToggle"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontSize" Value="14"/></Style>
        <Style Selector="Border.contextSegment"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style Selector="Button.msgPinBtn"><Setter Property="Background" Value="{StaticResource AccentGreen}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style Selector="Button.msgPinBtn.pinned"><Setter Property="Background" Value="#4CAF50"/></Style>
        <Style Selector="Button.msgSuppressBtn"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style Selector="Button.msgSuppressBtn.suppressed"><Setter Property="Background" Value="{StaticResource AccentRed}"/><Setter Property="Foreground" Value="White"/></Style>
        <Style Selector="Button.msgRemoveCtxBtn"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style Selector="TextBlock.compressionUncompressed"><Setter Property="Foreground" Value="{StaticResource AccentGreen}"/><Setter Property="FontSize" Value="9"/></Style>
        <Style Selector="TextBlock.compressionCompressed"><Setter Property="Foreground" Value="{StaticResource AccentOrange}"/><Setter Property="FontSize" Value="9"/></Style>
        <Style Selector="TextBlock.compressionEvicted"><Setter Property="Foreground" Value="{StaticResource AccentRed}"/><Setter Property="FontSize" Value="9"/></Style>
        <Style Selector="Border.statusBadge.green"><Setter Property="Background" Value="#4CAF50"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="6,2"/></Style>
        <Style Selector="Border.statusBadge.orange"><Setter Property="Background" Value="#FF9800"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="6,2"/></Style>
        <Style Selector="Border.statusBadge.red"><Setter Property="Background" Value="#FF6B6B"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="6,2"/></Style>
        <Style Selector="Button.headerDeleteBtn"><Setter Property="Background" Value="#2D2D30"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="8,2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style Selector="Button.headerDeleteBtn:pointerover"><Setter Property="Background" Value="#454549"/><Setter Property="Foreground" Value="{StaticResource AccentRed}"/></Style>
    </Window.Styles>

    <ContentControl>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

        <!-- ===== HEADER BAR (spans all columns) ===== -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource BgPrimary}" ClipToBounds="True">
            <Grid Margin="16,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- OpenLMStudio Title -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="OpenLMStudio" FontSize="16" FontWeight="SemiBold" Foreground="#4FC3F7" VerticalAlignment="Center"/>

                <!-- Main AI Model (centered) -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="48">
                    <TextBlock Text="Main AI:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Controls:MainModelSelector x:Name="MainModelSelectorControl"
                                                  Width="280"/>
                </StackPanel>

                <!-- Chat Title (for ChatTitleText reference, hidden from view) -->
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ChatTitleText" Text="Chat Session" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="False"/>

                <!-- System AI Model (aligned to right) -->
                <StackPanel Grid.Row="0" Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="48">
                    <TextBlock Text="System AI:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Controls:SystemModelSelector x:Name="SystemModelSelectorControl"
                                                  Width="280"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== LEFT SIDEBAR ===== -->
        <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource BgPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- VS Code-style TabStrip for left sidebar tabs -->
            <StackPanel x:Name="LeftTabStripPanel"
                        Orientation="Horizontal"
                        Background="Transparent">
                <!-- Settings tab -->
                <ToggleButton x:Name="SettingsTab"
                              Classes="vscodeTab"
                              Tag="Settings"
                              Height="32"
                              Padding="4,8"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Click="OnLeftTabClick"
                              ToolTip.Tip="Settings">
                    <TextBlock Text="&#x2699;&#xFE0E;" FontSize="16" TextAlignment="Center"/>
                </ToggleButton>
                <!-- Chat tab -->
                <ToggleButton x:Name="ChatTab"
                              Classes="vscodeTab"
                              Tag="Chat"
                              IsChecked="True"
                              Height="32"
                              Padding="4,8"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Click="OnLeftTabClick"
                              ToolTip.Tip="Chat">
                    <TextBlock Text="&#x1F4AC;" FontSize="16" TextAlignment="Center"/>
                </ToggleButton>
                <!-- Server tab -->
                <ToggleButton x:Name="ServerTab"
                              Classes="vscodeTab"
                              Tag="Server"
                              Height="32"
                              Padding="4,8"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Click="OnLeftTabClick"
                              ToolTip.Tip="Server">
                    <TextBlock Text="&#x1F5A5;" FontSize="16" TextAlignment="Center"/>
                </ToggleButton>
                <!-- Models tab -->
                <ToggleButton x:Name="ModelsTab"
                              Classes="vscodeTab"
                              Tag="Models"
                              Height="32"
                              Padding="4,8"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Click="OnLeftTabClick"
                              ToolTip.Tip="Models">
                    <TextBlock Text="&#x1F4E6;" FontSize="16" TextAlignment="Center"/>
                </ToggleButton>
                <!-- Devices tab -->
                <ToggleButton x:Name="DevicesTab"
                              Classes="vscodeTab"
                              Tag="Devices"
                              Height="32"
                              Padding="4,8"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Click="OnLeftTabClick"
                              ToolTip.Tip="Devices">
                    <TextBlock Text="&#x1F527;" FontSize="16" TextAlignment="Center"/>
                </ToggleButton>
                <!-- Context tab -->
                <ToggleButton x:Name="ContextTab"
                              Classes="vscodeTab"
                              Tag="Context"
                              Height="32"
                              Padding="4,8"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Click="OnLeftTabClick"
                              ToolTip.Tip="Context">
                    <TextBlock Text="&#x1F4CB;" FontSize="16" TextAlignment="Center"/>
                </ToggleButton>
                <!-- Pingu tab -->
                <ToggleButton x:Name="PinguTab"
                              Classes="vscodeTab"
                              Tag="Pingu"
                              Height="32"
                              Padding="4,8"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Click="OnLeftTabClick"
                              ToolTip.Tip="Pingu">
                    <TextBlock Text="&#x1F427;" FontSize="16" TextAlignment="Center"/>
                </ToggleButton>
                <!-- ImageGen tab -->
                <ToggleButton x:Name="ImageGenTab"
                              Classes="vscodeTab"
                              Tag="ImageGen"
                              Height="32"
                              Padding="4,8"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Click="OnLeftTabClick"
                              ToolTip.Tip="ImageGen">
                    <TextBlock Text="&#x1F3A8;" FontSize="16" TextAlignment="Center"/>
                </ToggleButton>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LeftTabContentPanel">
                        <!-- Chat tab content -->
                        <StackPanel x:Name="ChatTabContent" IsVisible="True">
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="8,4,8,8">
                                <TextBox x:Name="SearchText" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" Padding="10,6" FontSize="13"/>
                            </Border>
                            <StackPanel x:Name="ChatListPanel" Margin="0,4,0,0">
                                <TextBlock Text="No chats loaded" Foreground="{StaticResource TextMuted}" Padding="12,8" FontSize="12"/>
                            </StackPanel>
                            <!-- + New Chat button moved into Chats container -->
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="8,16,8,8">
                                <Button x:Name="NewChatButton" Content="+ New Chat" Background="#0E639C" Foreground="White" Padding="12,6" FontSize="13" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Create a new chat session"/>
                            </Border>
                        </StackPanel>

                        <!-- Server tab content -->
                        <StackPanel x:Name="ServerTabContent" IsVisible="False">
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ServerStatusText" Text="Server: Stopped" Foreground="{StaticResource AccentRed}" Padding="12,8"/>
                                    <TextBlock x:Name="ServerPortText" Text="Port: 8080" Padding="12,4"/>
                                    <Button x:Name="LeftServerStartStopButton" Content="Start Server" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,8,8,8" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Start or stop the local server"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Models tab content -->
                        <StackPanel x:Name="ModelsTabContent" IsVisible="False">
                            <StackPanel>
                                <TextBlock Text="No models loaded" Foreground="{StaticResource TextMuted}" Padding="12,8" FontSize="12"/>
                            </StackPanel>
                            <Button x:Name="AddModelButton" Content="+ Add Model" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,8,8,0" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Add a new model"/>
                        </StackPanel>

                        <!-- Devices tab content -->
                        <StackPanel x:Name="DevicesTabContent" IsVisible="False">
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="GPU: None Detected" Foreground="{StaticResource TextPrimary}" Padding="12,8"/>
                                    <TextBlock x:Name="CpuCoreText" Text="CPU Cores: 8" Padding="12,4"/>
                                    <TextBlock x:Name="RamInfoText" Text="RAM: 32 GB Available" Padding="12,4"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LoadedModelRightText" Text="Loaded Model: None" Foreground="{StaticResource TextPrimary}" Padding="12,8"/>
                                    <TextBlock x:Name="ContextLengthRightText" Text="Context: 4096 tokens" Padding="12,4"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="LoadModelButton" Content="Load Model" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,8,8,0" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Load a model for inference"/>
                        </StackPanel>

                        <!-- Context tab content -->
                        <StackPanel x:Name="ContextTabContent" IsVisible="False">
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Context Budget:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                    <Border x:Name="ContextBudgetBar" Background="#3A3A3E" CornerRadius="4" Height="8" Margin="8,4,8,8"/>
                                    <TextBlock x:Name="ContextBudgetText" Text="Budget: 0 / 4096 tokens used" Foreground="{StaticResource TextSecondary}" Padding="8,0" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Compression:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                    <ComboBox x:Name="ContextCompressionSelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Margin="8,4,8,0" Height="32">
                                        <TextBlock Text="None"/><TextBlock Text="Light"/><TextBlock Text="Medium"/><TextBlock Text="Aggressive"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel x:Name="ContextInjectionSection">
                                    <TextBlock Text="Custom Context:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                    <Button x:Name="InjectCustomContextBtn" Content="+ Add Custom Context" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,4,8,8" HorizontalAlignment="Stretch" Height="32" ToolTip.Tip="Add custom context to the conversation"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel x:Name="ContextSegmentsPanel" Margin="0,4,0,0">
                                    <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="System Prompt" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="12"/>
                                                <Border Background="#2E7D32" CornerRadius="2" Padding="6,1"><TextBlock Text="Uncompressed (pinned)" FontSize="9" Foreground="White"/></Border>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#4CAF50" CornerRadius="2" Padding="6,2"><TextBlock Text="PINNED" FontSize="9" Foreground="White"/></Border>
                                        </Grid>
                                    </Border>
                                    <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Task Context" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="12"/>
                                                <Border Background="#2E7D32" CornerRadius="2" Padding="6,1"><TextBlock Text="Uncompressed (pinned)" FontSize="9" Foreground="White"/></Border>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#4CAF50" CornerRadius="2" Padding="6,2"><TextBlock Text="PINNED" FontSize="9" Foreground="White"/></Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel x:Name="CompressedSegmentsContainer">
                                        <TextBlock Text="No compressed segments" Foreground="{StaticResource TextMuted}" Padding="12,8" FontSize="10"/>
                                    </StackPanel>
                                    <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
                                        <TextBlock Text="Injected Context:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="12"/>
                                    </Border>
                                    <StackPanel x:Name="CustomContextSegmentsContainer"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="CustomContextInjectionPanel" IsVisible="False">
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Inject Type:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                        <ComboBox x:Name="ContextInjectionTypeSelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Margin="8,0,8,8" Height="32">
                                            <TextBlock Text="System Prompt (custom)"/><TextBlock Text="File Contents"/><TextBlock Text="Raw Context"/>
                                        </ComboBox>
                                        <TextBlock Text="Content:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                        <TextBox x:Name="CustomContextContentInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" BorderThickness="0" Margin="8,4,8,8" Height="80" AcceptsReturn="True"/>
                                        <Button x:Name="CustomContextInjectBtn" Content="Inject Context" Background="#4FC3F7" Foreground="White" Padding="12,4" Height="36" Margin="8" ToolTip.Tip="Inject the custom context"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Pingu tab content - agentic interaction -->
                        <StackPanel x:Name="PinguTabContent" IsVisible="False">
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Pingu Agent" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="12,8"/>
                                    <TextBlock Text="Control Pingu's behavior and interactions" Foreground="{StaticResource TextSecondary}" Padding="12,4" FontSize="12"/>
                                    <Button x:Name="PinguWakeButton" Content="Wake Pingu" Background="#4FC3F7" Foreground="White" Padding="8,4" Margin="8,8,8,4" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Wake up Pingu"/>
                                    <Button x:Name="PinguPauseButton" Content="Pause Pingu" Background="#FF9800" Foreground="White" Padding="8,4" Margin="8,4,8,4" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Pause Pingu"/>
                                    <Button x:Name="PinguResetButton" Content="Reset Pingu" Background="#FF6B6B" Foreground="White" Padding="8,4" Margin="8,4,8,8" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Reset Pingu"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Pingu Tools" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="12,8"/>
                                    <Button x:Name="PinguTabSwitchTool" Content="Tab Switch" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,4,8,4" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Switch tabs"/>
                                    <Button x:Name="PinguPanelToggleTool" Content="Toggle Panel" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,4,8,4" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Toggle panels"/>
                                    <Button x:Name="PinguModelLoadTool" Content="Load Model" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,4,8,4" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Load a model"/>
                                    <Button x:Name="PinguModelUnloadTool" Content="Unload Model" Background="#FF6B6B" Foreground="White" Padding="8,4" Margin="8,4,8,8" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Unload a model"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Pingu Generation" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="12,8"/>
                                    <TextBlock Text="Click to generate a new Pingu" Foreground="{StaticResource TextSecondary}" Padding="12,4" FontSize="12"/>
                                    <Button x:Name="PinguGenerateButton" Content="Generate Random Pingu" Background="#4FC3F7" Foreground="White" Padding="8,4" Margin="8,4,8,8" HorizontalAlignment="Stretch" Height="36" ToolTip.Tip="Generate a random Pingu"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Settings tab content - with nested sub-tabs -->
                        <StackPanel x:Name="SettingsTabContent" IsVisible="False">
                            <!-- Nested TabStrip for settings sub-tabs -->
                            <TabControl x:Name="SettingsSubTabsControl"
                                        Background="Transparent"
                                        BorderThickness="0">
                                <TabControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </TabControl.ItemsPanel>
                                <!-- Server sub-tab -->
                                <TabItem x:Name="SettingsServerSubTab"
                                         Classes="settingsSubTab"
                                         Tag="Server"
                                         IsSelected="True">
                                    <TabItem.Header>
                                        <TextBlock Text="&#x1F5A5;" FontSize="14" TextAlignment="Center"/>
                                    </TabItem.Header>
                                </TabItem>
                                <!-- Model sub-tab -->
                                <TabItem x:Name="SettingsModelSubTab"
                                         Classes="settingsSubTab"
                                         Tag="Model">
                                    <TabItem.Header>
                                        <TextBlock Text="&#x1F4E6;" FontSize="14" TextAlignment="Center"/>
                                    </TabItem.Header>
                                </TabItem>
                                <!-- Agent sub-tab -->
                                <TabItem x:Name="SettingsAgentSubTab"
                                         Classes="settingsSubTab"
                                         Tag="Agent">
                                    <TabItem.Header>
                                        <TextBlock Text="&#x1F916;" FontSize="14" TextAlignment="Center"/>
                                    </TabItem.Header>
                                </TabItem>
                                <!-- Plugin sub-tab -->
                                <TabItem x:Name="SettingsPluginSubTab"
                                         Classes="settingsSubTab"
                                         Tag="Plugin">
                                    <TabItem.Header>
                                        <TextBlock Text="&#x1F50C;" FontSize="14" TextAlignment="Center"/>
                                    </TabItem.Header>
                                </TabItem>
                                <!-- Data Privacy sub-tab -->
                                <TabItem x:Name="SettingsPrivacySubTab"
                                         Classes="settingsSubTab"
                                         Tag="DataPrivacy">
                                    <TabItem.Header>
                                        <TextBlock Text="&#x1F512;" FontSize="14" TextAlignment="Center"/>
                                    </TabItem.Header>
                                </TabItem>
                            </TabControl>

                            <!-- Server settings panel -->
                            <StackPanel x:Name="SettingsServerPanel">
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="Server Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Server Port"/>
                                    <TextBlock Classes="settingDescription" Text="The port the local API server will listen on. Default: 8080"/>
                                    <TextBox x:Name="SettingsPortInput" Classes="settingInput">
                                        <TextBox.Text>8080</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Enable HTTPS"/>
                                    <TextBlock Classes="settingDescription" Text="Use HTTPS for the local server (generates self-signed certificate automatically)"/>
                                    <CheckBox x:Name="SettingsHttpsEnabledCheckbox" Classes="settingToggle">
                                        <CheckBox.Content>Enable HTTPS</CheckBox.Content>
                                    </CheckBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="API Key (Optional)"/>
                                    <TextBlock Classes="settingDescription" Text="If set, clients must include this key in the Authorization header to use the API"/>
                                    <TextBox x:Name="SettingsApiKeyInput" Classes="settingInput"/>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Rate Limiting (Requests/Minute)"/>
                                    <TextBlock Classes="settingDescription" Text="Maximum number of requests per minute from a single client. 0 = no limit."/>
                                    <TextBox x:Name="SettingsRateLimitInput" Classes="settingInput">
                                        <TextBox.Text>60</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Context Length (Tokens)"/>
                                    <TextBlock Classes="settingDescription" Text="Maximum number of tokens for the context window. Default: 4096."/>
                                    <TextBox x:Name="SettingsContextLengthInput" Classes="settingInput">
                                        <TextBox.Text>4096</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Model settings panel -->
                            <StackPanel x:Name="SettingsModelPanel" IsVisible="False">
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="Model Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Model"/>
                                    <TextBlock Classes="settingDescription" Text="Model to use when no explicit model is selected."/>
                                    <ComboBox x:Name="SettingsDefaultModelSelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Padding="8,6">
                                        <TextBlock Text="Not Selected"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="GPU Layer Offloading (n-gpu-layers)"/>
                                    <TextBlock Classes="settingDescription" Text="Number of layers to offload to GPU. 0 = CPU only. -1 = auto-detect."/>
                                    <Slider x:Name="SettingsGpuOffloadSlider" Minimum="-1" Maximum="999" Value="-1"/>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Context Length Override"/>
                                    <TextBlock Classes="settingDescription" Text="Override the default context window size. Leave empty to use model native context."/>
                                    <TextBox x:Name="SettingsContextLengthOverrideInput" Classes="settingInput"/>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Temperature"/>
                                    <TextBlock Classes="settingDescription" Text="Controls randomness in responses. Higher = more creative, lower = more deterministic."/>
                                    <Slider x:Name="SettingsTemperatureSlider" Minimum="0" Maximum="2" Value="0.7"/>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Top-P"/>
                                    <TextBlock Classes="settingDescription" Text="Nucleus sampling parameter. Controls diversity by only considering tokens with cumulative probability >= top_p."/>
                                    <Slider x:Name="SettingsTopPValueSlider" Minimum="0" Maximum="1" Value="1.0"/>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Max Tokens"/>
                                    <TextBlock Classes="settingDescription" Text="Maximum number of tokens to generate in responses. 0 = no limit."/>
                                    <TextBox x:Name="SettingsMaxTokensInput" Classes="settingInput">
                                        <TextBox.Text>4096</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="Image Generation Defaults" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Resolution"/>
                                    <ComboBox x:Name="SettingsImageResInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Padding="8,6">
                                        <TextBlock Text="512x512"/>
                                        <TextBlock Text="768x768"/>
                                        <TextBlock Text="1024x1024"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Steps"/>
                                    <Slider x:Name="SettingsImageStepsSlider" Minimum="1" Maximum="100" Value="30"/>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default CFG Scale"/>
                                    <Slider x:Name="SettingsImageCfgSlider" Minimum="1.0" Maximum="20.0" Value="7.5"/>
                                </StackPanel>
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="Context Compression Defaults" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Compression Strategy"/>
                                    <ComboBox x:Name="SettingsCompressionStrategyInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Padding="8,6">
                                        <TextBlock Text="None"/>
                                        <TextBlock Text="Light"/>
                                        <TextBlock Text="Medium"/>
                                        <TextBlock Text="Aggressive"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Token Budget (per chat)"/>
                                    <TextBox x:Name="SettingsTokenBudgetInput" Classes="settingInput">
                                        <TextBox.Text>4096</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Agent settings panel -->
                            <StackPanel x:Name="SettingsAgentPanel" IsVisible="False">
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="Agent Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Max Agent Iterations"/>
                                    <TextBlock Classes="settingDescription" Text="Maximum number of iterations an agent task can run before being stopped."/>
                                    <TextBox x:Name="SettingsAgentIterationLimitInput" Classes="settingInput">
                                        <TextBox.Text>50</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Agent Default Turns"/>
                                    <TextBlock Classes="settingDescription" Text="Number of turns added when Agent Mode is toggled on. When toggled off, turns reset to 0."/>
                                    <TextBox x:Name="SettingsAgentDefaultTurnsInput" Classes="settingInput">
                                        <TextBox.Text>10</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Auto-Commit File Threshold (KB)"/>
                                    <TextBlock Classes="settingDescription" Text="Files smaller than this size will be auto-committed without user review."/>
                                    <TextBox x:Name="SettingsAgentAutoCommitSizeInput" Classes="settingInput">
                                        <TextBox.Text>1024</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Require Plan Approval for Risky Operations"/>
                                    <CheckBox x:Name="SettingsAgentPlanApprovalCheckbox" Classes="settingToggle">
                                        <CheckBox.Content>Require approval before executing risky operations (file writes, commands)</CheckBox.Content>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Plugin settings panel -->
                            <StackPanel x:Name="SettingsPluginPanel" IsVisible="False">
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="Plugin and MCP Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Plugin Registry URL"/>
                                    <TextBlock Classes="settingDescription" Text="URL of the plugin registry to download plugins from. Leave empty for local-only plugins."/>
                                    <TextBox x:Name="SettingsPluginRegistryUrlInput" Classes="settingInput"/>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Auto-Update Check Interval (minutes)"/>
                                    <TextBlock Classes="settingDescription" Text="How often to check for plugin updates. Set to 0 to disable auto-updates."/>
                                    <TextBox x:Name="SettingsPluginUpdateIntervalInput" Classes="settingInput">
                                        <TextBox.Text>60</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Plugin Sandbox Policy"/>
                                    <ComboBox x:Name="SettingsPluginSandboxPolicyInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Padding="8,6">
                                        <TextBlock Text="Strict (No filesystem access)"/>
                                        <TextBlock Text="Restricted (Read-only filesystem)"/>
                                        <TextBlock Text="Full (Unrestricted)"/>
                                    </ComboBox>
                                </StackPanel>
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="MCP Client Defaults" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="MCP Client Timeout (seconds)"/>
                                    <TextBox x:Name="SettingsMcptimeoutInput" Classes="settingInput">
                                        <TextBox.Text>30</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Maximum Tools per MCP Server"/>
                                    <TextBox x:Name="SettingsMaxToolsPerServerInput" Classes="settingInput">
                                        <TextBox.Text>50</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Data Privacy settings panel -->
                            <StackPanel x:Name="SettingsPrivacyPanel" IsVisible="False">
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="Data Privacy and Storage" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Encrypt Conversations at Rest"/>
                                    <TextBlock Classes="settingDescription" Text="AES-256 encrypt all conversation data stored on disk. Requires a master password."/>
                                    <CheckBox x:Name="SettingsEncryptionEnabledCheckbox" Classes="settingToggle">
                                        <CheckBox.Content>Enable encryption</CheckBox.Content>
                                    </CheckBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Default Conversation Export Format"/>
                                    <ComboBox x:Name="SettingsExportFormatInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Padding="8,6">
                                        <TextBlock Text="JSON"/>
                                        <TextBlock Text="Markdown"/>
                                        <TextBlock Text="HTML"/>
                                    </ComboBox>
                                </StackPanel>
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                                    <TextBlock Text="Model Cache Cleanup" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                                </Border>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Least Recently Used Model Cache Timeout (days)"/>
                                    <TextBlock Classes="settingDescription" Text="Models not used within this period may be unloaded to free memory."/>
                                    <TextBox x:Name="SettingsCacheTimeoutInput" Classes="settingInput">
                                        <TextBox.Text>30</TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Classes="settingItem">
                                    <TextBlock Classes="settingLabel" Text="Auto-Cleanup Orphaned Model Files"/>
                                    <CheckBox x:Name="SettingsAutoCleanupCheckbox" Classes="settingToggle">
                                        <CheckBox.Content>Delete model files that are no longer in the registry</CheckBox.Content>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Invisible overlay to catch clicks outside the title while editing -->
        <Border x:Name="TitleEditOverlay"
                Grid.Row="1"
                Grid.Column="1"
                Background="Transparent"
                IsVisible="False"
                PointerPressed="OnTitleEditOverlayPointerPressed">
        </Border>

        <!-- ===== CENTER PANE ===== -->
        <Grid x:Name="CenterPaneGrid" Grid.Row="1" Grid.Column="1" Background="#1A1A1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Inner Grid for chat content (left side of center pane) -->
            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Token Count and Streaming (in chat pane) -->
                <Grid Grid.Row="0" Background="{StaticResource BgSecondary}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tokens + Streaming -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,12">
                        <Border Background="#333338" CornerRadius="4">
                            <TextBlock x:Name="TokenCountText" Text="Tokens: 0" Padding="12,6" FontSize="12"/>
                        </Border>
                        <Border Background="#333338" CornerRadius="4" Margin="16,0,0,0">
                            <StackPanel x:Name="StreamingIndicator" Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreen}" Margin="0,2,6,0"/>
                                <TextBlock Text="Streaming" Padding="4,6" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Chat Title (clipped when wide) -->
                    <Border Grid.Column="1"
                            Padding="16,12"
                            HorizontalAlignment="Stretch">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,10000,40"/>
                        </Border.Clip>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- Chat Title Display (click to edit) -->
                            <TextBlock x:Name="ChatTitleDisplay"
                                       Text="Chat Session"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Padding="12,6"
                                       Cursor="Hand"
                                       PointerPressed="OnChatTitleClicked">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock:pointerover">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <!-- Chat Title Edit (hidden by default) -->
                            <TextBox x:Name="ChatTitleEdit"
                                     x:DataType="local:MainWindow"
                                     IsVisible="{Binding IsChatTitleEditing}"
                                     Foreground="{StaticResource TextPrimary}"
                                     Background="{StaticResource BgTertiary}"
                                     BorderBrush="#3A3A3E"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontSize="13"
                                     MaxWidth="500"
                                     LostFocus="OnChatTitleLostFocus"
                                     KeyDown="OnChatTitleKeyDown"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Delete Chat button (anchored to the right edge) -->
                    <Button Grid.Column="2"
                            x:Name="DeleteChatButton"
                            Content="&#x2715;"
                            Background="#B91C1C"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="10,6"
                            FontSize="14"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            Margin="0,0,16,0"
                            Click="OnDeleteChatClicked"
                            ToolTip.Tip="Delete this chat session">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessageDisplayPanel" Margin="24,24,24,0">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <TextBlock Text="Welcome to OpenLMStudio! Select a model and start chatting." Foreground="#AAAAAA" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource BgSecondary}">
                    <Grid Margin="0,8,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BgTertiary}" Margin="16,0,16,8">
                            <TextBox x:Name="MessageInputBox" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" Padding="16,12" FontSize="14" MaxHeight="120" MinHeight="60"/>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,4" VerticalAlignment="Bottom">
                            <!-- Agent Mode (clickable emoji with turns badge) -->
                            <Border Background="{StaticResource BgTertiary}" CornerRadius="6" Padding="8,0" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Agent emoji with floating turns count -->
                                    <Grid Width="44" Height="44" Margin="0,0,2,0">
                                        <Button x:Name="AgentModeToggle" Content="&#x1F916;" FontSize="34" Padding="0" Classes="AgentModeToggle" Foreground="{StaticResource AccentBlue}" Cursor="Hand"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="Toggle agent mode"/>
                                        <!-- Floating turns count badge - clickable, positioned to the very bottom right -->
                                        <Button x:Name="AgentTurnsBadge"
                                                Cursor="Hand"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,4,-4"
                                                Click="OnAgentTurnsBadgeClicked"
                                                IsHitTestVisible="True"
                                                Background="{StaticResource AccentOrange}"
                                                Foreground="White"
                                                ToolTip.Tip="Agent turns count">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                                </Style>
                                            </Button.Styles>
                                            <TextBlock x:Name="AgentTurnsText" Text="0" Foreground="White" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Plan/Act Toggle -->
                            <Border Background="{StaticResource BgTertiary}" CornerRadius="6" Padding="0,0" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="36">
                                    <Border Background="{StaticResource BgTertiary}" CornerRadius="6" Padding="6,0" Width="130" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel x:Name="PlanActPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button x:Name="PlanButton"
                                                    Content="Plan"
                                                    Width="55" Height="32"
                                                    Click="OnPlanClicked"
                                                    Classes="active"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip.Tip="Switch to Plan mode">
                                                <Button.Styles>
                                                    <Style Selector="Button">
                                                        <Setter Property="Background" Value="#2D2D30"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </Style>
                                                    <Style Selector="Button.active">
                                                        <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Style>
                                                    <Style Selector="Button:pointerover">
                                                        <Setter Property="Background" Value="{Binding (Button.Background), RelativeSource={RelativeSource Self}}"/>
                                                    </Style>
                                                </Button.Styles>
                                            </Button>
                                            <Button x:Name="ActButton"
                                                    Content="Act"
                                                    Width="55" Height="32"
                                                    Click="OnActClicked"
                                                    Padding="0,0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip.Tip="Switch to Act mode">
                                                <Button.Styles>
                                                    <Style Selector="Button">
                                                        <Setter Property="Background" Value="#2D2D30"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </Style>
                                                    <Style Selector="Button.active">
                                                        <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Style>
                                                    <Style Selector="Button:pointerover">
                                                        <Setter Property="Background" Value="{Binding (Button.Background), RelativeSource={RelativeSource Self}}"/>
                                                    </Style>
                                                </Button.Styles>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Safety Mode -->
                            <Border Background="{StaticResource BgTertiary}" CornerRadius="6" Padding="8,0" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ToggleButton x:Name="SafetyWWW"
                                                  Content="&#x1F310;"
                                                  Width="36" Height="36"
                                                  Padding="0"
                                                  FontSize="22"
                                                  Background="#2D2D30"
                                                  Foreground="{StaticResource TextPrimary}"
                                                  Margin="0,0,3,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip.Tip="Web safety">
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton:pointerover">
                                                <Setter Property="Background" Value="{Binding (ToggleButton.Background), RelativeSource={RelativeSource Self}}"/>
                                            </Style>
                                            <Style Selector="ToggleButton:checked">
                                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </ToggleButton.Styles>
                                    </ToggleButton>
                                        <ToggleButton x:Name="SafetyRead"
                                                      Content="&#x1F441;"
                                                      Width="36" Height="36"
                                                      Padding="0"
                                                      FontSize="22"
                                                      Background="#2D2D30"
                                                      Foreground="{StaticResource TextPrimary}"
                                                  Margin="0,0,3,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip.Tip="Read safety">
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton:pointerover">
                                                <Setter Property="Background" Value="{Binding (ToggleButton.Background), RelativeSource={RelativeSource Self}}"/>
                                            </Style>
                                            <Style Selector="ToggleButton:checked">
                                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </ToggleButton.Styles>
                                    </ToggleButton>
                                        <ToggleButton x:Name="SafetyEdit"
                                                      Content="&#x270E;"
                                                      Width="36" Height="36"
                                                      Padding="0"
                                                      FontSize="22"
                                                      Background="#2D2D30"
                                                      Foreground="{StaticResource TextPrimary}"
                                                  Margin="0,0,3,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip.Tip="Edit safety">
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton:pointerover">
                                                <Setter Property="Background" Value="{Binding (ToggleButton.Background), RelativeSource={RelativeSource Self}}"/>
                                            </Style>
                                            <Style Selector="ToggleButton:checked">
                                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </ToggleButton.Styles>
                                    </ToggleButton>
                                        <ToggleButton x:Name="SafetyExec"
                                                      Content="&#x2699;"
                                                      Width="36" Height="36"
                                                      Padding="0"
                                                      FontSize="22"
                                                      Background="#2D2D30"
                                                      Foreground="{StaticResource TextPrimary}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip.Tip="Execute safety">
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton:pointerover">
                                                <Setter Property="Background" Value="{Binding (ToggleButton.Background), RelativeSource={RelativeSource Self}}"/>
                                            </Style>
                                            <Style Selector="ToggleButton:checked">
                                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </ToggleButton.Styles>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                                <Grid Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ToolsButton"
                                            Content="🔧"
                                            Width="60" Height="36"
                                            Background="{StaticResource BgTertiary}"
                                            Foreground="{StaticResource TextPrimary}"
                                            Padding="0"
                                            Click="OnToolsButtonClicked"
                                            Cursor="Hand"
                                            Grid.Column="1"
                                            ToolTip.Tip="Open tools">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </Style>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#3A3A3E"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    <Button x:Name="SendButton"
                                            Content="Send"
                                            Width="60" Height="36"
                                            Background="{StaticResource AccentBlue}"
                                            Foreground="White"
                                            Padding="0"
                                            Click="OnSendMessageClicked"
                                            Cursor="Hand"
                                            ToolTip.Tip="Send the message">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="MainAI" Click="OnSendTargetSelected" Tag="MainAI"/>
                                                <MenuItem Header="Pingu" Click="OnSendTargetSelected" Tag="Pingu"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- PinguCanvas positioned in the bottom-right of the center pane -->
            <Canvas x:Name="PinguCornerPanel" Grid.Column="1" Grid.Row="1" IsVisible="False" Panel.ZIndex="100" Background="#1A1A1E" MinWidth="200" MinHeight="200" MaxWidth="500" MaxHeight="500"/>
        </Grid>


        <!-- ===== RIGHT SIDEBAR (simplified - only Active Tasks header + Pingu home tile) ===== -->
        <Grid Grid.Row="1" Grid.Column="2" Background="{StaticResource BgPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Simplified: only Active Tasks header -->
            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                <TextBlock Text="Active Tasks" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="16,12,16,8" FontSize="14"/>
                <TextBlock x:Name="RightActiveTasksText" Text="No active tasks" Foreground="{StaticResource TextMuted}" Padding="16,8" FontSize="12"/>
            </StackPanel>
            <!-- Pingu Home tile at the bottom of the sidebar -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSecondary}"
                    Padding="0">
                <Controls:PinguHomeTile x:Name="PinguHomeTile"
                                        HorizontalAlignment="Stretch"
                                        Height="120"
                                        PointerPressed="OnPinguHomeTileClicked"/>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource BgSecondary}">
            <DockPanel>
                <Border DockPanel.Dock="Left" x:Name="GitStatusBorder" Background="Transparent" Padding="12,0" Cursor="Hand">
                    <TextBlock x:Name="GitStatusText" Text="OpenLMStudio" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Border DockPanel.Dock="Left" x:Name="ServerStatusBorder" Background="Transparent" Padding="8,0">
                    <TextBlock x:Name="ServerStatusTextStatusBar" Text="Server: --" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Border DockPanel.Dock="Left" x:Name="CpuStatusBorder" Background="Transparent" Padding="8,0">
                    <TextBlock x:Name="CpuStatusText" Text="CPU: --" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Border DockPanel.Dock="Left" x:Name="GpuStatusBorder" Background="Transparent" Padding="8,0">
                    <TextBlock x:Name="GpuStatusText" Text="GPU: --" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <!-- Status bar buttons (right side) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StatusFolderButton"
                            Content="&#x1F4C1;"
                            Background="Transparent"
                            Foreground="{StaticResource TextMuted}"
                            Padding="8,0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="OnStatusFolderClicked"
                            ToolTip.Tip="Open app folder">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="StatusNewChatButton"
                            Content="&#x1F4DC;"
                            Background="Transparent"
                            Foreground="{StaticResource TextMuted}"
                            Padding="8,0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="OnStatusNewChatClicked"
                            ToolTip.Tip="Load example chats">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="StatusResetButton"
                            Content="&#x274C;"
                            Background="Transparent"
                            Foreground="{StaticResource AccentRed}"
                            Padding="8,0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="OnStatusResetClicked"
                            ToolTip.Tip="Reset the app">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
                                <Setter Property="Foreground" Value="#FF8888"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="StatusAboutButton"
                            Content="&#x3F;"
                            Background="Transparent"
                            Foreground="{StaticResource TextMuted}"
                            Padding="8,0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="OnStatusAboutClicked"
                            ToolTip.Tip="About OpenLMStudio">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

          <!-- Git log popup -->
          <Popup x:Name="GitLogPopup" Width="960" Height="560" IsOpen="False" Placement="Top" Topmost="True">
              <Border Background="Transparent" PointerPressed="OnGitLogOverlayClicked">
                  <Border Background="{StaticResource BgPrimary}"
                          BorderBrush="#3A3A3E"
                          BorderThickness="1"
                          CornerRadius="8"
                          Width="960"
                          Height="560">
                      <Controls:GitLogTable x:Name="GitLogTableControl" CloseRequested="{Binding ElementName=GitLogPopup, Path=IsOpen, Mode=TwoWay}"/>
                  </Border>
              </Border>
          </Popup>

        <!-- Tool call popup — uses Popup control with center pane Grid as PlacementTarget -->
        <Popup x:Name="ToolCallPopup"
               PlacementTarget="{Binding ElementName=CenterPaneGrid}"
               Placement="Bottom"
               HorizontalOffset="0"
               VerticalOffset="0"
               IsOpen="False"
               Topmost="True">
            <Border Background="{StaticResource BgSecondary}"
                    BorderBrush="#333338"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="440"
                    MaxHeight="500">
                <StackPanel>
                    <!-- Tool list header -->
                    <Border Background="{StaticResource BgTertiary}"
                            CornerRadius="8,8,0,0"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Select a Tool" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="13"/>
                            <Button Grid.Column="1" x:Name="CloseToolPopup"
                                    Content="✕"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondary}"
                                    Padding="6,2"
                                    FontSize="12"
                                    Click="OnCloseToolPopupClicked"
                                    ToolTip.Tip="Close the tool popup"/>
                        </Grid>
                    </Border>
                    <!-- Tool list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                        <StackPanel x:Name="ToolListPanel" Margin="8,4,8,8"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Image Generation tab content — uses ImageGenerationTab control (overlay in center pane) -->
        <ContentControl x:Name="ImageGenerationOverlay"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        ZIndex="10"
                        IsVisible="False"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <Border Background="#1A1A1E"
                    CornerRadius="8"
                    Padding="0">
                <Controls:ImageGenerationTab x:Name="ImageGenerationTab"/>
            </Border>
        </ContentControl>
        </Grid>
    </ContentControl>
</Window>
