<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenLMStudio.Desktop.MainWindow"
        xmlns:Controls="clr-namespace:OpenLMStudio.Desktop.Controls"
        Width="1400" Height="750"
        MinWidth="1000" MinHeight="600">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="TextMuted" Color="#666666"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9800"/>
        <SolidColorBrush x:Key="SendButtonColor" Color="#0E639C"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.accent"><Setter Property="Background" Value="{StaticResource AccentBlue}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,4"/></Style>
        <Style Selector="Button.action"><Setter Property="Background" Value="{StaticResource SendButtonColor}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8,4"/></Style>
        <Style Selector="ToggleButton.tab"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="12,6"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.chatItem"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="13"/></Style>
        <Style Selector="Border.userMessage"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="CornerRadius" Value="8,0,8,8"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,4,8"/></Style>
        <Style Selector="Border.assistantMessage"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="CornerRadius" Value="0,8,8,8"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="4,0,0,8"/></Style>
        <Style Selector="Ellipse.statusDot"><Setter Property="Fill" Value="{StaticResource AccentRed}"/><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="Margin" Value="0,2,6,0"/></Style>
        <Style Selector="Border.inputArea"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="12"/></Style>
        <Style Selector="Border.searchBar"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,6"/></Style>
        <Style Selector="ToggleButton.toolTab"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="12,6"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="ToggleButton.rightPanelTab"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="CornerRadius" Value="4"/></Style>
        <Style Selector="ToggleButton.rightPanelTab:checked"><Setter Property="Background" Value="{StaticResource AccentBlue}"/><Setter Property="Foreground" Value="White"/></Style>
        <Style Selector="TabItem.toolTab"><Setter Property="Padding" Value="4,2"/><Setter Property="Margin" Value="2,1"/><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontSize" Value="11"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Height" Value="26"/></Style>
        <Style Selector="TabItem.toolTab:selected"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/><Setter Property="Foreground" Value="{StaticResource AccentBlue}"/></Style>
        <Style Selector="TabItem.toolTab:hover"><Setter Property="Background" Value="#3A3A3E"/></Style>
        <Style Selector="RadioButton.settingsTab"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="16,8"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="FontSize" Value="13"/></Style>
        <Style Selector="RadioButton.settingsTab:checked"><Setter Property="Background" Value="{StaticResource BgSecondary}"/><Setter Property="Foreground" Value="{StaticResource AccentBlue}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/></Style>
        <Style Selector="StackPanel.settingItem"><Setter Property="Margin" Value="0,4,0,12"/></Style>
        <Style Selector="TextBlock.settingLabel"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
        <Style Selector="TextBlock.settingDescription"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
        <Style Selector="TextBox.settingInput"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3A3A3E"/></Style>
        <Style Selector="Button.saveBtn"><Setter Property="Background" Value="{StaticResource AccentBlue}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/></Style>
        <Style Selector="Button.cancelBtn"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="16,8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3A3A3E"/></Style>
        <Style Selector="CheckBox.settingToggle"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontSize" Value="14"/></Style>
        <Style Selector="Border.contextSegment"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style Selector="Button.msgPinBtn"><Setter Property="Background" Value="{StaticResource AccentGreen}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style Selector="Button.msgPinBtn.pinned"><Setter Property="Background" Value="#4CAF50"/></Style>
        <Style Selector="Button.msgSuppressBtn"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style Selector="Button.msgSuppressBtn.suppressed"><Setter Property="Background" Value="{StaticResource AccentRed}"/><Setter Property="Foreground" Value="White"/></Style>
        <Style Selector="Button.msgRemoveCtxBtn"><Setter Property="Background" Value="{StaticResource BgTertiary}"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style Selector="TextBlock.compressionUncompressed"><Setter Property="Foreground" Value="{StaticResource AccentGreen}"/><Setter Property="FontSize" Value="9"/></Style>
        <Style Selector="TextBlock.compressionCompressed"><Setter Property="Foreground" Value="{StaticResource AccentOrange}"/><Setter Property="FontSize" Value="9"/></Style>
        <Style Selector="TextBlock.compressionEvicted"><Setter Property="Foreground" Value="{StaticResource AccentRed}"/><Setter Property="FontSize" Value="9"/></Style>
        <Style Selector="Border.statusBadge.green"><Setter Property="Background" Value="#4CAF50"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="6,2"/></Style>
        <Style Selector="Border.statusBadge.orange"><Setter Property="Background" Value="#FF9800"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="6,2"/></Style>
        <Style Selector="Border.statusBadge.red"><Setter Property="Background" Value="#FF6B6B"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="6,2"/></Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ===== LEFT SIDEBAR ===== -->
        <Grid Grid.Column="0" Background="{StaticResource BgPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="OpenLMStudio" FontSize="18" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="16,16,16,8"/>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" x:Name="LeftTabControl" SelectionChanged="OnLeftTabControlSelectionChanged">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Height="24" Orientation="Horizontal">
                                <ItemsPresenter x:Name="PART_ItemsPresenter" DockPanel.Dock="Top"/>
                            </StackPanel>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Content="{Binding SelectedContent, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0"/>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <!-- Chat tab -->
                <TabItem Header="Chats" x:Name="ChatTabItem" Classes="toolTab">
                    <StackPanel x:Name="ChatTabContent" IsVisible="True">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="8,4,8,8">
                            <TextBox x:Name="SearchText" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" Padding="10,6" FontSize="13"/>
                        </Border>
                        <StackPanel x:Name="ChatListPanel" Margin="0,4,0,0">
                            <TextBlock Text="No chats loaded" Foreground="{StaticResource TextMuted}" Padding="12,8" FontSize="12"/>
                        </StackPanel>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,16,0,0">
                            <TextBlock Text="Folders" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="8,8"/>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Server tab -->
                <TabItem Header="Server" x:Name="ServerTabItem" Classes="toolTab">
                    <StackPanel x:Name="ServerTabContent" IsVisible="False">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ServerStatusText" Text="Server: Stopped" Foreground="{StaticResource AccentRed}" Padding="12,8"/>
                                <TextBlock x:Name="ServerPortText" Text="Port: 8080" Padding="12,4"/>
                                <Button x:Name="LeftServerStartStopButton" Content="Start Server" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,8,8,8" HorizontalAlignment="Stretch" Height="36"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Models tab -->
                <TabItem Header="Models" x:Name="ModelsTabItem" Classes="toolTab">
                    <StackPanel x:Name="ModelsTabContent" IsVisible="False">
                        <StackPanel>
                            <TextBlock Text="No models loaded" Foreground="{StaticResource TextMuted}" Padding="12,8" FontSize="12"/>
                        </StackPanel>
                        <Button x:Name="AddModelButton" Content="+ Add Model" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,8,8,0" HorizontalAlignment="Stretch" Height="36"/>
                    </StackPanel>
                </TabItem>

                <!-- Devices tab -->
                <TabItem Header="Devices" x:Name="DevicesTabItem" Classes="toolTab">
                    <StackPanel x:Name="DevicesTabContent" IsVisible="False">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="GPU: None Detected" Foreground="{StaticResource TextPrimary}" Padding="12,8"/>
                                <TextBlock x:Name="CpuCoreText" Text="CPU Cores: 8" Padding="12,4"/>
                                <TextBlock x:Name="RamInfoText" Text="RAM: 32 GB Available" Padding="12,4"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LoadedModelRightText" Text="Loaded Model: None" Foreground="{StaticResource TextPrimary}" Padding="12,8"/>
                                <TextBlock x:Name="ContextLengthRightText" Text="Context: 4096 tokens" Padding="12,4"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="LoadModelButton" Content="Load Model" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,8,8,0" HorizontalAlignment="Stretch" Height="36"/>
                    </StackPanel>
                </TabItem>

                <!-- Context tab -->
                <TabItem Header="Context" x:Name="ContextTabItem" Classes="toolTab">
                    <StackPanel x:Name="ContextTabContent" IsVisible="False">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Context Budget:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <Border x:Name="ContextBudgetBar" Background="#3A3A3E" CornerRadius="4" Height="8" Margin="8,4,8,8"/>
                                <TextBlock x:Name="ContextBudgetText" Text="Budget: 0 / 4096 tokens used" Foreground="{StaticResource TextSecondary}" Padding="8,0" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Compression:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <ComboBox x:Name="ContextCompressionSelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Margin="8,4,8,0" Height="32">
                                    <TextBlock Text="None"/><TextBlock Text="Light"/><TextBlock Text="Medium"/><TextBlock Text="Aggressive"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel x:Name="ContextInjectionSection">
                                <TextBlock Text="Custom Context:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <Button x:Name="InjectCustomContextBtn" Content="+ Add Custom Context" Background="#0E639C" Foreground="White" Padding="8,4" Margin="8,4,8,8" HorizontalAlignment="Stretch" Height="32"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel x:Name="ContextSegmentsPanel" Margin="0,4,0,0">
                                <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="System Prompt" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="12"/>
                                            <Border Background="#2E7D32" CornerRadius="2" Padding="6,1"><TextBlock Text="Uncompressed (pinned)" FontSize="9" Foreground="White"/></Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#4CAF50" CornerRadius="2" Padding="6,2"><TextBlock Text="PINNED" FontSize="9" Foreground="White"/></Border>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Task Context" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="12"/>
                                            <Border Background="#2E7D32" CornerRadius="2" Padding="6,1"><TextBlock Text="Uncompressed (pinned)" FontSize="9" Foreground="White"/></Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#4CAF50" CornerRadius="2" Padding="6,2"><TextBlock Text="PINNED" FontSize="9" Foreground="White"/></Border>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="CompressedSegmentsContainer">
                                    <TextBlock Text="No compressed segments" Foreground="{StaticResource TextMuted}" Padding="12,8" FontSize="10"/>
                                </StackPanel>
                                <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
                                    <TextBlock Text="Injected Context:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="12"/>
                                </Border>
                                <StackPanel x:Name="CustomContextSegmentsContainer"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="CustomContextInjectionPanel" IsVisible="False">
                            <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Inject Type:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                    <ComboBox x:Name="ContextInjectionTypeSelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Margin="8,0,8,8" Height="32">
                                        <TextBlock Text="System Prompt (custom)"/><TextBlock Text="File Contents"/><TextBlock Text="Raw Context"/>
                                    </ComboBox>
                                    <TextBlock Text="Content:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                    <TextBox x:Name="CustomContextContentInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" BorderThickness="0" Margin="8,4,8,8" Height="80" AcceptsReturn="True"/>
                                    <Button x:Name="CustomContextInjectBtn" Content="Inject Context" Background="#4FC3F7" Foreground="White" Padding="12,4" Height="36" Margin="8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- Tasks tab -->
                <TabItem Header="Tasks" x:Name="TasksTabItem" Classes="toolTab">
                    <StackPanel x:Name="TasksTabContent" IsVisible="False">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel x:Name="TaskListPanel">
                                <TextBlock Text="No tasks created" Foreground="{StaticResource TextMuted}" Padding="12,8" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="New Task:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <TextBox x:Name="NewTaskDescriptionInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" BorderThickness="0" Margin="8,4,8,8" Height="60" AcceptsReturn="True"/>
                                <TextBlock Text="Priority:" Foreground="{StaticResource TextPrimary}" Padding="12,4,12,2"/>
                                <ComboBox x:Name="TaskPrioritySelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Margin="8,0,8,8" Height="28">
                                    <TextBlock Text="Low"/><TextBlock Text="Normal" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="High"/><TextBlock Text="Critical"/>
                                </ComboBox>
                                <Button x:Name="CreateTaskButton" Content="+ Create Task" Background="#0E639C" Foreground="White" Padding="12,4" HorizontalAlignment="Stretch" Height="36"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Agent tab -->
                <TabItem Header="Agent" x:Name="AgentTabItem" Classes="toolTab">
                    <StackPanel x:Name="AgentTabContent" IsVisible="False">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Task:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <TextBox x:Name="AgentTaskInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" BorderThickness="0" Margin="8,4,8,8" Height="80" AcceptsReturn="True"/>
                                <TextBlock Text="Max Iterations:" Foreground="{StaticResource TextPrimary}" Padding="12,4,12,2"/>
                                <Slider x:Name="AgentMaxIterationsSlider" Minimum="10" Maximum="200" Value="50" Margin="8,4,8,8" TickFrequency="10" IsSnapToTickEnabled="True"/>
                                <TextBlock x:Name="AgentMaxIterationsText" Text="50" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center"/>
                                <Button x:Name="AgentStartButton" Content="Start Agent" Background="#0E639C" Foreground="White" Padding="12,4" HorizontalAlignment="Stretch" Height="36"/>
                                <Button x:Name="AgentStopButton" Content="Stop Agent" Background="#FF6B6B" Foreground="White" Padding="12,4" HorizontalAlignment="Stretch" Height="36" Margin="8,4,8,8" IsVisible="False"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Progress:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <Border x:Name="AgentProgressBar" Background="#3A3A3E" CornerRadius="4" Height="8" Margin="8,4,8,8"/>
                                <TextBlock x:Name="AgentProgressText" Foreground="{StaticResource TextSecondary}" Padding="8,0" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AgentToolLog">
                                    <TextBlock Text="No tool calls yet" Foreground="{StaticResource TextMuted}" Padding="12,8" FontSize="11"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Games tab -->
                <TabItem Header="Games" x:Name="GamesTabItem" Classes="toolTab">
                    <StackPanel x:Name="GamesTabContent" IsVisible="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <Controls:GamesPanel x:Name="LeftGamesPanel"/>
                        </ScrollViewer>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Pingu" x:Name="PinguTabItem" Classes="toolTab">
                    <StackPanel x:Name="PinguTabContent" IsVisible="False">
                        <Controls:PinguPanel x:Name="LeftPinguPanel" Margin="0,8,0,0"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="ImageGen" x:Name="ImageGenTabItem" Classes="toolTab">
                    <StackPanel x:Name="ImageGenTabContent" IsVisible="False">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Select Model:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <ComboBox x:Name="ImageGenModelSelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Margin="8,4,8,8" Height="32"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Prompt:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <TextBox x:Name="ImageGenPromptInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" BorderThickness="0" Margin="8,4,8,8" Height="60" AcceptsReturn="True"/>
                                <TextBlock Text="Negative Prompt (optional):" Foreground="{StaticResource TextPrimary}" Padding="12,4,12,2"/>
                                <TextBox x:Name="ImageGenNegPromptInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" BorderThickness="0" Margin="8,4,8,8" Height="60" AcceptsReturn="True"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Parameters:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="Resolution:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="ImageGenResolutionSelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Margin="8,0,0,0" Height="28">
                                        <TextBlock Text="512x512"/><TextBlock Text="768x768"/><TextBlock Text="1024x1024"/><TextBlock Text="1280x720" Foreground="{StaticResource TextPrimary}"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="Steps:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="ImageGenStepsSlider" Minimum="1" Maximum="50" Value="20" Margin="8,0,8,0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding ElementName=ImageGenStepsSlider, Path=Value, StringFormat={}{0:F0}}" Width="30" Foreground="{StaticResource TextSecondary}"/>
                                </DockPanel>
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="CFG:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="ImageGenCfgSlider" Minimum="1.0" Maximum="20.0" Value="7.5" IsSnapToTickEnabled="True" TickFrequency="0.5" Margin="8,0,8,0"/>
                                    <TextBlock Text="{Binding ElementName=ImageGenCfgSlider, Path=Value, StringFormat={}{0:F1}}" Width="35" Foreground="{StaticResource TextSecondary}"/>
                                </DockPanel>
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="Seed:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="ImageGenSeedInput" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" BorderThickness="0" Margin="8,0,0,0" Width="120" Height="28"/>
                                    <Button x:Name="RandomSeedButton" Content="&#x1F3B2;" Background="#0E639C" Foreground="White" Padding="6,4" Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <Button x:Name="ImageGenGenerateBtn" Content="Generate Image" Background="#4FC3F7" Foreground="White" Padding="12,4" Height="40" Margin="8"/>
                        </Border>
                        <TextBlock x:Name="ImageGenProgressText" Foreground="{StaticResource TextMuted}" Padding="12,4" FontSize="12"/>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Output:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <Border x:Name="ImageGenOutputArea" Background="{StaticResource BgTertiary}" CornerRadius="4" Margin="8,4,8,8">
                                    <TextBlock Text="Generated image will appear here" Foreground="{StaticResource TextMuted}" Padding="20" FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Batch Generation:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <DockPanel Margin="8,4,8,4">
                                    <TextBlock Text="Count:" Width="70" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="ImageGenBatchSizeSlider" Minimum="1" Maximum="16" Value="1" Margin="8,0,8,0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Text="{Binding ElementName=ImageGenBatchSizeSlider, Path=Value, StringFormat={}{0:F0}}" Width="30" Foreground="{StaticResource TextSecondary}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="LoRA Adapters:" Foreground="{StaticResource TextPrimary}" Padding="12,4"/>
                                <ComboBox x:Name="ImageGenLoraSelector" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Margin="8,4,8,0" Height="32"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Analysis tab -->
                <TabItem Header="Analysis" x:Name="AnalysisTabItem" Classes="toolTab">
                    <StackPanel x:Name="AnalysisTabContent" IsVisible="False">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="AI Analysis Context:" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="12,8"/>
                                <DockPanel Margin="8,4"><TextBlock Text="Analyzed At:" Width="90" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="AnalysisTimestampText" Text="N/A" Foreground="{StaticResource TextPrimary}" DockPanel.Dock="Right"/></DockPanel>
                                <DockPanel Margin="8,4"><TextBlock Text="Token Count:" Width="90" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="AnalysisTokenCountText" Text="0" Foreground="{StaticResource TextPrimary}" DockPanel.Dock="Right"/></DockPanel>
                                <TextBlock Text="Compressed History:" Foreground="{StaticResource TextPrimary}" Padding="8,4"/>
                                <ScrollViewer Height="120" Margin="8,0"><TextBlock x:Name="AnalysisHistoryText" Text="No compressed history" Foreground="{StaticResource TextMuted}" Padding="4" FontSize="10"/></ScrollViewer>
                                <TextBlock Text="Project State:" Foreground="{StaticResource TextPrimary}" Padding="8,4"/>
                                <ScrollViewer Height="120" Margin="8,0"><TextBlock x:Name="AnalysisProjectStateText" Text="No project state" Foreground="{StaticResource TextMuted}" Padding="4" FontSize="10"/></ScrollViewer>
                                <TextBlock Text="Relevant Context Segments:" Foreground="{StaticResource TextPrimary}" Padding="8,4"/>
                                <TextBlock x:Name="AnalysisSegmentsText" Text="N/A" Foreground="{StaticResource TextMuted}" Padding="8" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Bottom buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,8,8,8">
                <Button x:Name="NewChatButton" Content="+ New Chat" Background="#0E639C" Foreground="White" Padding="8,4" Height="36" Margin="0,0,4,0"/>
                <Button x:Name="SettingsButton" Content="&#x2699;&#xFE0E;" Background="#252529" Foreground="{StaticResource TextPrimary}" Padding="8,4" Height="36"/>
            </StackPanel>
        </Grid>

        <!-- ===== CENTER PANE ===== -->
        <Panel Grid.Column="1" Background="#1A1A1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgSecondary}">
                    <StackPanel Orientation="Horizontal" Margin="16,12">
                        <TextBlock x:Name="ChatTitleText" Text="Chat Session" FontWeight="SemiBold"/>
                        <Border Background="#333338" CornerRadius="4" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Model: " Padding="12,6,4,6"/>
                                <TextBlock x:Name="SelectedModelText" Text="Not Selected" Padding="4,6,12,6"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#333338" CornerRadius="4" Margin="16,0,0,0">
                            <TextBlock x:Name="TokenCountText" Text="Tokens: 0" Padding="12,6"/>
                        </Border>
                        <Border Background="#333338" CornerRadius="4" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" x:Name="StreamingIndicator">
                                <Ellipse x:Name="StreamingIndicatorDot" Width="10" Height="10" Fill="{StaticResource AccentGreen}" Margin="0,2,6,0"/>
                                <TextBlock Text="Streaming" Padding="4,6" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessageDisplayPanel" Margin="24,24,24,0">
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <TextBlock Text="Welcome to OpenLMStudio! Select a model and start chatting." Foreground="#AAAAAA" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource BgSecondary}">
                    <Grid Margin="0,8,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BgTertiary}" Margin="16,0,16,8">
                            <TextBox x:Name="MessageInputBox" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" Padding="16,12" FontSize="14" MaxHeight="120" MinHeight="60"/>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
                            <ToggleButton x:Name="CodeInterpreterToggle" Content="Code Interpreter" Background="#2D2D30" Foreground="{StaticResource TextPrimary}" Padding="12,6"/>
                            <TextBlock Text="" Foreground="#CCCCCC" FontSize="12" Padding="4,6"/>
                            <ToggleButton x:Name="ProjectManagementToggle" Content="Project Management" Background="#2D2D30" Foreground="{StaticResource TextPrimary}" Padding="12,6"/>
                        </StackPanel>
                        <Button x:Name="SendButton" Content="Send" Grid.RowSpan="3" Width="60" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,8" Background="{StaticResource AccentBlue}" Foreground="White"/>
                    </Grid>
                </Border>
            </Grid>
        </Panel>

        <!-- ===== RIGHT SIDEBAR ===== -->
        <!-- Will be used for active task stuff when implemented -->
        <Panel x:Name="RightSidebarPanel" Grid.Column="2" Background="{StaticResource BgPrimary}">
            <StackPanel>
                <TextBlock Text="Active Tasks" FontWeight="SemiBold" Foreground="#4FC3F7" Padding="16,12" FontSize="14"/>
                <TextBlock Text="No active tasks" Foreground="{StaticResource TextMuted}" Padding="16,8" FontSize="12"/>
            </StackPanel>
        </Panel>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource BgSecondary}">
            <DockPanel>
                <Border DockPanel.Dock="Left" x:Name="GitStatusBorder" Background="Transparent" Padding="12,0" Cursor="Hand">
                    <TextBlock x:Name="GitStatusText" Text="OpenLMStudio" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Border DockPanel.Dock="Left" x:Name="ServerStatusBorder" Background="Transparent" Padding="8,0">
                    <TextBlock x:Name="ServerStatusTextStatusBar" Text="Server: --" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Border DockPanel.Dock="Left" x:Name="CpuStatusBorder" Background="Transparent" Padding="8,0">
                    <TextBlock x:Name="CpuStatusText" Text="CPU: --" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Border DockPanel.Dock="Left" x:Name="GpuStatusBorder" Background="Transparent" Padding="8,0">
                    <TextBlock x:Name="GpuStatusText" Text="GPU: --" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="OpenLMStudio" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Padding="12,0"/>
            </DockPanel>
        </Border>

        <!-- Git log popup -->
        <Popup x:Name="GitLogPopup">
            <Border Background="{StaticResource BgSecondary}" BorderBrush="#333338" BorderThickness="1" CornerRadius="4" Width="600" Height="400">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="GitLogContent" Text="Git log" Foreground="{StaticResource TextPrimary}" Padding="12" FontSize="12" TextWrapping="Wrap" Margin="8"/>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
