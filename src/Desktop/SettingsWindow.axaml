<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenLMStudio.Desktop.SettingsWindow"
        Width="900" Height="700">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="RadioButton.settingsTab">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <Style Selector="RadioButton.settingsTab:checked">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
        </Style>

        <Style Selector="StackPanel.settingItem">
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <Style Selector="TextBlock.settingLabel">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="TextBlock.settingDescription">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <Style Selector="TextBox.settingInput">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
        </Style>

        <Style Selector="Button.saveBtn">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
        </Style>

        <Style Selector="CheckBox.settingToggle">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <RadioButton x:Name="ServerTabButton" 
                         Content="Server"
                         Classes="settingsTab"
                         IsChecked="True"/>
            
            <RadioButton x:Name="ModelTabButton"
                         Content="Model"
                         Classes="settingsTab"/>
            
             <RadioButton x:Name="AgentTabButton"
                          Content="Agent"
                          Classes="settingsTab"/>
             
             <RadioButton x:Name="PluginTabButton"
                          Content="Plugin"
                          Classes="settingsTab"/>
         </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="ServerSettingsPanel">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="Server Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Server Port"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="The port the local API server will listen on. Default: 8080"/>
                        <TextBox x:Name="PortSettingInput" Classes="settingInput">
                            <TextBox.Text>8080</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Enable HTTPS"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Use HTTPS for the local server (generates self-signed certificate automatically)"/>
                        <CheckBox x:Name="HttpsEnabledCheckbox" Classes="settingToggle">
                            <CheckBox.Content>Enable HTTPS</CheckBox.Content>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="API Key (Optional)"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="If set, clients must include this key in the Authorization header to use the API"/>
                        <TextBox x:Name="ApiKeySettingInput" Classes="settingInput"/>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Rate Limiting (Requests/Minute)"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Maximum number of requests per minute from a single client. 0 = no limit."/>
                        <TextBox x:Name="RateLimitSettingInput" Classes="settingInput">
                            <TextBox.Text>60</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Context Length (Tokens)"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Maximum number of tokens for the context window. Default: 4096."/>
                        <TextBox x:Name="ContextLengthSettingInput" Classes="settingInput">
                            <TextBox.Text>4096</TextBox.Text>
                        </TextBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ModelSettingsPanel" IsVisible="False">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="Model Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Model"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Model to use when no explicit model is selected."/>
                        <ComboBox x:Name="DefaultModelSelector" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <TextBlock Text="Not Selected"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="GPU Layer Offloading (n-gpu-layers)"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Number of layers to offload to GPU. 0 = CPU only. -1 = auto-detect."/>
                        <Slider x:Name="GpuOffloadSlider" Minimum="-1" Maximum="999" Value="-1"/>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Context Length Override"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Override the default context window size. Leave empty to use model native context."/>
                        <TextBox x:Name="ContextLengthOverrideInput" Classes="settingInput"/>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Temperature"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Controls randomness in responses. Higher = more creative, lower = more deterministic."/>
                        <Slider x:Name="TemperatureSlider" Minimum="0" Maximum="2" Value="0.7"/>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Top-P"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Nucleus sampling parameter. Controls diversity by only considering tokens with cumulative probability >= top_p."/>
                        <Slider x:Name="TopPValueSlider" Minimum="0" Maximum="1" Value="1.0"/>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Max Tokens"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Maximum number of tokens to generate in responses. 0 = no limit."/>
                        <TextBox x:Name="MaxTokensSettingInput" Classes="settingInput">
                            <TextBox.Text>4096</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                        <TextBlock Text="Image Generation Defaults" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Resolution"/>
                        <ComboBox x:Name="ImageResSettingInput" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <TextBlock Text="512x512"/>
                            <TextBlock Text="768x768"/>
                            <TextBlock Text="1024x1024"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Steps"/>
                        <Slider x:Name="ImageStepsSettingSlider" Minimum="1" Maximum="100" Value="30"/>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default CFG Scale"/>
                        <Slider x:Name="ImageCfgSettingSlider" Minimum="1.0" Maximum="20.0" Value="7.5"/>
                    </StackPanel>

                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                        <TextBlock Text="Context Compression Defaults" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Compression Strategy"/>
                        <ComboBox x:Name="CompressionStrategyInput" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <TextBlock Text="None"/>
                            <TextBlock Text="Light"/>
                            <TextBlock Text="Medium"/>
                            <TextBlock Text="Aggressive"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Token Budget (per chat)"/>
                        <TextBox x:Name="TokenBudgetInput" Classes="settingInput">
                            <TextBox.Text>4096</TextBox.Text>
                        </TextBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="AgentSettingsPanel" IsVisible="False">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="Agent Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Max Agent Iterations"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Maximum number of iterations an agent task can run before being stopped."/>
                        <TextBox x:Name="AgentIterationLimitInput" Classes="settingInput">
                            <TextBox.Text>50</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Auto-Commit File Threshold (KB)"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Files smaller than this size will be auto-committed without user review."/>
                        <TextBox x:Name="AgentAutoCommitSizeInput" Classes="settingInput">
                            <TextBox.Text>1024</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Require Plan Approval for Risky Operations"/>
                        <CheckBox x:Name="AgentPlanApprovalCheckbox" Classes="settingToggle">
                            <CheckBox.Content>Require approval before executing risky operations (file writes, commands)</CheckBox.Content>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PluginSettingsPanel" IsVisible="False">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="Plugin and MCP Settings" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="18"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Plugin Registry URL"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="URL of the plugin registry to download plugins from. Leave empty for local-only plugins."/>
                        <TextBox x:Name="PluginRegistryUrlInput" Classes="settingInput"/>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Auto-Update Check Interval (minutes)"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="How often to check for plugin updates. Set to 0 to disable auto-updates."/>
                        <TextBox x:Name="PluginUpdateIntervalInput" Classes="settingInput">
                            <TextBox.Text>60</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Plugin Sandbox Policy"/>
                        <ComboBox x:Name="PluginSandboxPolicyInput" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <TextBlock Text="Strict (No filesystem access)"/>
                            <TextBlock Text="Restricted (Read-only filesystem)"/>
                            <TextBlock Text="Full (Unrestricted)"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                        <TextBlock Text="MCP Client Defaults" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="MCP Client Timeout (seconds)"/>
                        <TextBox x:Name="McptimeoutInput" Classes="settingInput">
                            <TextBox.Text>30</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Maximum Tools per MCP Server"/>
                        <TextBox x:Name="MaxToolsPerServerInput" Classes="settingInput">
                            <TextBox.Text>50</TextBox.Text>
                        </TextBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="DataPrivacyPanel" IsVisible="False">
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,0,0,16">
                        <TextBlock Text="Data Privacy and Storage" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Encrypt Conversations at Rest"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="AES-256 encrypt all conversation data stored on disk. Requires a master password."/>
                        <CheckBox x:Name="EncryptionEnabledCheckbox" Classes="settingToggle">
                            <CheckBox.Content>Enable encryption</CheckBox.Content>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Default Conversation Export Format"/>
                        <ComboBox x:Name="ExportFormatInput" 
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource BgTertiary}"
                                  Padding="8,6">
                            <TextBlock Text="JSON"/>
                            <TextBlock Text="Markdown"/>
                            <TextBlock Text="HTML"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="20" Margin="0,8,0,16">
                        <TextBlock Text="Model Cache Cleanup" FontWeight="SemiBold" Foreground="#4FC3F7" FontSize="16"/>
                    </Border>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Least Recently Used Model Cache Timeout (days)"/>
                        <TextBlock Classes="settingDescription" 
                                   Text="Models not used within this period may be unloaded to free memory."/>
                        <TextBox x:Name="CacheTimeoutInput" Classes="settingInput">
                            <TextBox.Text>30</TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Classes="settingItem">
                        <TextBlock Classes="settingLabel" Text="Auto-Cleanup Orphaned Model Files"/>
                        <CheckBox x:Name="AutoCleanupCheckbox" Classes="settingToggle">
                            <CheckBox.Content>Delete model files that are no longer in the registry</CheckBox.Content>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgPrimary}" Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Classes="cancelBtn"
                        Margin="0,0,8,0"/>
                <Button x:Name="SaveSettingsBtn"
                        Content="Save"
                        Classes="saveBtn"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>