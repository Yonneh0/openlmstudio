<UserControl x:Class="OpenLMStudio.Desktop.Controls.VMWizardStep4"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:qemu="clr-namespace:OpenLMStudio.Domain.Models.QEMU;assembly=OpenLMStudio.Domain">

    <StackPanel>
        <TextBlock Text="Step 4 of 5: Network Devices"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AddNetButton" Content="+ Add Network" Padding="12,6"/>
            <TextBlock x:Name="NetCountText" Text="0 devices" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="NetList"
                 Height="200"
                 Background="#FFF">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Id}" Width="80"/>
                        <TextBlock Text="{Binding BackendType}" Width="100"/>
                        <TextBlock Text="{Binding MacAddress}" Width="120"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>