<UserControl x:Class="OpenLMStudio.Desktop.Controls.TetrisGame"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="240" Height="420">

    <StackPanel Margin="8">
        <TextBlock Text="Tetris"
                   HorizontalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8">
            <TextBlock x:Name="ScoreText"
                       Text="Score: 0"
                       FontSize="14"
                       Margin="0,0,16,0"/>
            <Button x:Name="ResetButton"
                    Content="Reset"
                    FontSize="12"/>
        </StackPanel>

        <Border x:Name="GameBoard"
                Background="#111"
                BorderThickness="2"
                BorderBrush="#444"
                CornerRadius="2"/>

        <TextBlock x:Name="StatusText"
                   Text="Press any arrow key to start"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"
                   FontSize="12"/>
    </StackPanel>
</UserControl>