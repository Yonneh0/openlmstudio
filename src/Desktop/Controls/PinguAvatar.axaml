<UserControl x:Class="OpenLMStudio.Desktop.Controls.PinguAvatar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="80"
    Height="80"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <Panel>
        <!-- Avatar body -->
        <Ellipse x:Name="Body"
                 Width="70" Height="70"
                 Fill="White"
                 Stroke="Black"
                 StrokeThickness="2"/>

        <!-- Eyes -->
        <Ellipse x:Name="EyeLeft"
                 Width="10" Height="14"
                 Fill="Black"/>
        <Ellipse x:Name="EyeRight"
                 Width="10" Height="14"
                 Fill="Black"/>

        <!-- Mouth -->
        <Ellipse x:Name="Mouth"
                 Width="20" Height="8"
                 Fill="Black"/>

        <!-- Blink overlay (hides eyes when blinking) - positioned over the eyes at top-center -->
        <Border x:Name="BlinkOverlay"
                Width="22" Height="10"
                Background="Black"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"/>
    </Panel>
</UserControl>