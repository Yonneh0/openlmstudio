<UserControl x:Class="OpenLMStudio.Desktop.Controls.JezzballGame"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="600" Height="450">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Jezzball" Foreground="#CCC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ScoreText" Text="Score: 0" Foreground="#CCC" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="NewGameButton" Content="New Game" Margin="16,0,0,0" Padding="8,2" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Game Board -->
        <Canvas x:Name="GameBoard" Grid.Row="1" Background="#000"/>
    </Grid>
</UserControl>