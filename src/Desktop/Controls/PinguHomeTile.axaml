<UserControl x:Class="OpenLMStudio.Desktop.Controls.PinguHomeTile"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="public">

    <Border x:Name="TileBorder" Background="{StaticResource BgSecondary}"
            PointerPressed="OnTileClicked">
        <Canvas x:Name="HomeCanvas" Background="#1E1E22"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
    </Border>
</UserControl>
