<UserControl x:Class="OpenLMStudio.Desktop.Controls.VMWizardStep3"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:qemu="clr-namespace:OpenLMStudio.Domain.Models;assembly=OpenLMStudio.Domain">

    <StackPanel>
        <TextBlock Text="Step 3 of 5: Disk Images"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AddDiskButton" Content="+ Add Disk" Padding="12,6"/>
            <TextBlock x:Name="DiskCountText" Text="0 disks" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="DiskList"
                 Height="200"
                 Background="#FFF">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="qemu:DiskImageConfig">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Format}" Width="60"/>
                        <TextBlock Text="{Binding Media}" Width="60"/>
                        <TextBlock Text="{Binding File}" TextWrapping="Wrap" Width="200"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>