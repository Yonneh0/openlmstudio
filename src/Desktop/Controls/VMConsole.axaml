<UserControl x:Class="OpenLMStudio.Desktop.Controls.VMConsole"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="800" Height="400">

    <Border Background="#0C0C0C"
            CornerRadius="8"
            Margin="4"
            BorderBrush="#333"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="#1E1E1E"
                    Padding="8"
                    Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                <TextBlock Text="Terminal"
                           Foreground="#CCC"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="ClearButton"
                        Content="Clear"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        FontSize="11"/>
                <Button x:Name="CopyButton"
                        Content="Copy"
                        Margin="4,0,0,0"
                        Padding="8,2"
                        FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Terminal Output -->
            <ScrollViewer x:Name="TerminalScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <Canvas x:Name="TerminalCanvas"
                        Width="800"
                        Height="350"
                        Background="#0C0C0C"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>