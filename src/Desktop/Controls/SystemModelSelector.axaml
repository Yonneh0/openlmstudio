<UserControl x:Class="OpenLMStudio.Desktop.Controls.LogViewer"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400"
             Padding="8">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Log Viewer" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="13" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ClearButton" Content="Clear" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}" Padding="6,2" FontSize="10" Margin="0,0,4,0" Cursor="Hand"/>
                <Button x:Name="ExportButton" Content="Export" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}" Padding="6,2" FontSize="10" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="LogTextBox"
                 Background="{StaticResource BgSecondary}"
                 Foreground="{StaticResource TextPrimary}"
                 BorderThickness="0"
                 Padding="8"
                 FontFamily="Consolas, 'Courier New', monospace"
                 FontSize="11"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 MaxHeight="400"
                 MinHeight="100"
                 TextWrapping="NoWrap"/>
    </StackPanel>
</UserControl>
</content>
