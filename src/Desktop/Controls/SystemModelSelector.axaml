<path>src/Desktop/Controls/LogViewer.axaml.cs</path>
<content>
using System;
using System.Collections.ObjectModel;
using System.Linq;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Interactivity;
using Avalonia.Media;
using OpenLMStudio.Domain.Models.LLamaCpp;
using OpenLMStudio.Infrastructure.Services;

namespace OpenLMStudio.Desktop.Controls;

public partial class LogViewer : UserControl
{
    private readonly LogViewerService _logViewerService;
    private EngineType _engine = EngineType.Primary;
    private string? _searchText;
    private LogLevel? _minLevel;

    public LogViewer(LogViewerService logViewerService)
    {
        _logViewerService = logViewerService;
        InitializeComponent();

        ClearButton.Click += OnClearClicked;
        ExportButton.Click += OnExportClicked;

        _logViewerService.LogEntryAdded += OnLogEntryAdded;
        _logViewerService.LogCleared += OnLogCleared;
    }

    public EngineType Engine
    {
        get => _engine;
        set
        {
            _engine = value;
            RefreshLogs();
        }
    }

    public string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _logViewerService.SetSearchText(value);
            RefreshLogs();
        }
    }

    public LogLevel? MinLevel
    {
        get => _minLevel;
        set
        {
            _minLevel = value;
            _logViewerService.SetMinLevel(value);
            RefreshLogs();
        }
    }

    private void OnLogEntryAdded(object? sender, LogEntry e)
    {
        Dispatcher.UIThread.InvokeAsync(() =>
        {
            var color = LogViewerService.GetColorForLevel(e.Level);
            var emoji = LogViewerService.GetEmojiForLevel(e.Level);
            var timestamp = e.Timestamp.ToString("HH:mm:ss");
            var line = $"[{timestamp}] {emoji} {e.Message}";

            var currentText = LogTextBox.Text ?? string.Empty;
            LogTextBox.Text = currentText + line + "\n";
            LogTextBox.CaretIndex = LogTextBox.Text.Length;
        });
    }

    private void OnLogCleared(object? sender, string engine)
    {
        Dispatcher.UIThread.InvokeAsync(() =>
        {
            LogTextBox.Text = string.Empty;
        });
    }

    private void RefreshLogs()
    {
        var logs = _logViewerService.GetFilteredLogs(_engine);
        var sb = new System.Text.StringBuilder();
        foreach (var log in logs)
        {
            var color = LogViewerService.GetColorForLevel(log.Level);
            var emoji = LogViewerService.GetEmojiForLevel(log.Level);
            var timestamp = log.Timestamp.ToString("HH:mm:ss");
            sb.AppendLine($"[{timestamp}] {emoji} {log.Message}");
        }
        LogTextBox.Text = sb.ToString();
    }

    private void OnClearClicked(object? sender, RoutedEventArgs e)
    {
        _logViewerService.ClearLogs(_engine);
    }

    private void OnExportClicked(object? sender, RoutedEventArgs e)
    {
        var window = TopLevel.GetTopLevel(this) as Window;
        if (window == null) return;

        var savePicker = new FilePickerSaveOptions
        {
            Title = "Export Log",
            SuggestedFileName = $"engine-log-{_engine}-{DateTime.Now:yyyyMMdd}.txt",
            DefaultExtension = "txt",
            FileTypeChoices = new[]
            {
                new FileTypePicker("Text Files", new[] { "*.txt" }),
                new FileTypePicker("All Files", new[] { "*.*" })
            }
        };

        var file = window.StorageProvider.SaveFilePickerAsync(savePicker).GetAwaiter().GetResult();
        if (file != null)
        {
            var logs = _logViewerService.GetFilteredLogs(_engine);
            var sb = new System.Text.StringBuilder();
            foreach (var log in logs)
                sb.AppendLine($"[{log.Timestamp:yyyy-MM-dd HH:mm:ss}] [{log.Level}] [{log.Source}] {log.Message}");

            System.IO.File.WriteAllText(file.Path.LocalPath, sb.ToString());
        }
    }
}
</content>
