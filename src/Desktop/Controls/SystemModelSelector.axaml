<UserControl x:Class="OpenLMStudio.Desktop.Controls.AdvancedSettings"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="500"
             Padding="16">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Advanced Settings" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="16" Margin="0,0,0,16"/>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="GPU Layers" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
            <Slider x:Name="GpuLayersSlider" Minimum="0" Maximum="99" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
            <TextBlock x:Name="GpuLayersValue" Text="0" Foreground="{StaticResource TextSecondary}" FontSize="10" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Context Size" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
            <Slider x:Name="CtxSizeSlider" Minimum="512" Maximum="65536" Value="4096" TickFrequency="256" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
            <TextBlock x:Name="CtxSizeValue" Text="4096" Foreground="{StaticResource TextSecondary}" FontSize="10" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Batch Size" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
            <Slider x:Name="BatchSizeSlider" Minimum="1" Maximum="8192" Value="512" TickFrequency="64" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
            <TextBlock x:Name="BatchSizeValue" Text="512" Foreground="{StaticResource TextSecondary}" FontSize="10" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Threads" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
            <Slider x:Name="ThreadsSlider" Minimum="1" Maximum="64" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
            <TextBlock x:Name="ThreadsValue" Text="4" Foreground="{StaticResource TextSecondary}" FontSize="10" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <CheckBox x:Name="FlashAttentionCheck" Content="Flash Attention" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
            <CheckBox x:Name="KvOffloadCheck" Content="KV Offload" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
            <CheckBox x:Name="MmapCheck" Content="Memory-Mapped I/O" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
            <CheckBox x:Name="MlockCheck" Content="Lock in RAM" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Chat Template" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ChatTemplateCombo" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Height="32"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Speculative Decoding" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="SpecTypeCombo" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" Height="32">
                <TextBlock Text="None"/><TextBlock Text="Draft-Simple"/><TextBlock Text="Draft-MTP"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Draft N-Max" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
            <Slider x:Name="DraftNMaxSlider" Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
            <TextBlock x:Name="DraftNMaxValue" Text="3" Foreground="{StaticResource TextSecondary}" FontSize="10" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="LoRA Adapter" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="LoraAdapterPath" Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgTertiary}" BorderThickness="1" Height="28" Margin="0,0,0,4"/>
            <Button x:Name="BrowseLoraButton" Content="Browse" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}" Padding="8,4" Height="28" Cursor="Hand"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="ApplyButton" Content="Apply" Background="{StaticResource AccentBlue}" Foreground="White" Padding="16,8" FontSize="13" Margin="0,0,8,0" Cursor="Hand"/>
            <Button x:Name="ResetButton" Content="Reset" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}" Padding="16,8" FontSize="13" Cursor="Hand"/>
            <Button x:Name="CancelButton" Content="Cancel" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}" Padding="16,8" FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</UserControl>
</content>
