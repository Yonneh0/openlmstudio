<path>src/Desktop/Controls/AdvancedSettings.axaml.cs</path>
<content>
using System;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Interactivity;
using Avalonia.Media;
using OpenLMStudio.Domain.Models.LLamaCpp;
using OpenLMStudio.Infrastructure.Services;

namespace OpenLMStudio.Desktop.Controls;

public partial class AdvancedSettings : UserControl
{
    public event EventHandler<RecommendedSettings>? SettingsApplied;
    private readonly RecommendedSettings? _originalSettings;

    public AdvancedSettings(RecommendedSettings? originalSettings = null)
    {
        _originalSettings = originalSettings;
        InitializeComponent();

        GpuLayersSlider.ValueChanged += OnSliderValueChanged;
        CtxSizeSlider.ValueChanged += OnSliderValueChanged;
        BatchSizeSlider.ValueChanged += OnSliderValueChanged;
        ThreadsSlider.ValueChanged += OnSliderValueChanged;
        DraftNMaxSlider.ValueChanged += OnSliderValueChanged;

        if (originalSettings != null)
        {
            GpuLayersSlider.Value = originalSettings.GpuLayers;
            CtxSizeSlider.Value = originalSettings.ContextSize;
            BatchSizeSlider.Value = originalSettings.BatchSize;
            ThreadsSlider.Value = originalSettings.Threads;
            FlashAttentionCheck.IsChecked = originalSettings.FlashAttention;
            KvOffloadCheck.IsChecked = originalSettings.KvOffload;
            MmapCheck.IsChecked = originalSettings.Mmap;
            MlockCheck.IsChecked = originalSettings.Mlock;
        }
        else
        {
            GpuLayersSlider.Value = 99;
            CtxSizeSlider.Value = 4096;
            BatchSizeSlider.Value = 512;
            ThreadsSlider.Value = Environment.ProcessorCount;
            FlashAttentionCheck.IsChecked = true;
            KvOffloadCheck.IsChecked = true;
            MmapCheck.IsChecked = true;
            MlockCheck.IsChecked = false;
        }

        ApplyButton.Click += OnApplyClicked;
        ResetButton.Click += OnResetClicked;
        CancelButton.Click += OnCancelClicked;
        BrowseLoraButton.Click += OnBrowseLoraClicked;
    }

    private void OnSliderValueChanged(object? sender, RangeBaseValueChangedEventArgs e)
    {
        GpuLayersValue.Text = ((int)GpuLayersSlider.Value).ToString();
        CtxSizeValue.Text = ((int)CtxSizeSlider.Value).ToString();
        BatchSizeValue.Text = ((int)BatchSizeSlider.Value).ToString();
        ThreadsValue.Text = ((int)ThreadsSlider.Value).ToString();
        DraftNMaxValue.Text = ((int)DraftNMaxSlider.Value).ToString();
    }

    private void OnApplyClicked(object? sender, RoutedEventArgs e)
    {
        var settings = new RecommendedSettings(
            GpuLayers: (int)GpuLayersSlider.Value,
            ContextSize: (int)CtxSizeSlider.Value,
            BatchSize: (int)BatchSizeSlider.Value,
            Threads: (int)ThreadsSlider.Value,
            FlashAttention: FlashAttentionCheck.IsChecked == true,
            KvOffload: KvOffloadCheck.IsChecked == true,
            Mmap: MmapCheck.IsChecked == true,
            Mlock: MlockCheck.IsChecked == true,
            Pooling: null,
            Embedding: false,
            Reranking: false);

        SettingsApplied?.Invoke(this, settings);
    }

    private void OnResetClicked(object? sender, RoutedEventArgs e)
    {
        if (_originalSettings != null)
        {
            GpuLayersSlider.Value = _originalSettings.GpuLayers;
            CtxSizeSlider.Value = _originalSettings.ContextSize;
            BatchSizeSlider.Value = _originalSettings.BatchSize;
            ThreadsSlider.Value = _originalSettings.Threads;
            FlashAttentionCheck.IsChecked = _originalSettings.FlashAttention;
            KvOffloadCheck.IsChecked = _originalSettings.KvOffload;
            MmapCheck.IsChecked = _originalSettings.Mmap;
            MlockCheck.IsChecked = _originalSettings.Mlock;
        }
    }

    private void OnCancelClicked(object? sender, RoutedEventArgs e)
    {
        // Close the parent window/dialog
        var window = FindParent<Window>();
        window?.Close();
    }

    private void OnBrowseLoraClicked(object? sender, RoutedEventArgs e)
    {
        var window = TopLevel.GetTopLevel(this) as Window;
        if (window == null) return;

        var filePicker = new OpenFileDialogOptions
        {
            Title = "Select LoRA Adapter",
            AllowMultiple = false,
            FileTypeFilter = new[] { new FileTypeFilter("GGUF Files", new[] { "*.gguf" }) }
        };

        var files = window.StorageProvider.OpenFilePickerAsync(filePicker).GetAwaiter().GetResult();
        if (files?.Any() == true)
        {
            LoraAdapterPath.Text = files.First().Path.LocalPath;
        }
    }

    private T? FindParent<T>() where T : class
    {
        var parent = this.Parent;
        while (parent != null)
        {
            if (parent is T typed)
                return typed;
            parent = parent.Parent;
        }
        return null;
    }
}
</content>
