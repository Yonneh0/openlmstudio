<UserControl x:Class="OpenLMStudio.Desktop.Controls.GamesPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenLMStudio.Desktop.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <DockPanel Margin="8">
        <!-- Game selector -->
        <ComboBox x:Name="GameSelector"
                  DockPanel.Dock="Top"
                  Margin="0,0,0,8"
                  SelectedIndex="0">
            <ComboBoxItem Content="Minesweeper" Tag="minesweeper"/>
            <ComboBoxItem Content="Tetris" Tag="tetris"/>
            <ComboBoxItem Content="Snake" Tag="snake"/>
            <ComboBoxItem Content="Jezzball" Tag="jezzball"/>
            <ComboBoxItem Content="Solitaire" Tag="solitaire"/>
        </ComboBox>

        <!-- Active game content -->
        <Border x:Name="ActiveGameContainer"
                DockPanel.Dock="Top"
                Background="#1E1E22"
                CornerRadius="4"
                Padding="0"/>

        <!-- Close button -->
        <Button x:Name="CloseGameButton"
                Content="✕"
                DockPanel.Dock="Bottom"
                HorizontalAlignment="Right"
                Background="Transparent"
                Foreground="{DynamicResource TextSecondary}"
                Padding="8,4"
                Margin="0,8,0,0"/>
    </DockPanel>
</UserControl>