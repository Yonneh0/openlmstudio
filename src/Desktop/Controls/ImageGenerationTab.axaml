<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenLMStudio.Desktop.Controls.ImageGenerationTab"
             xmlns:local="clr-namespace:OpenLMStudio.Desktop.Controls">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9800"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
    </UserControl.Resources>

    <StackPanel Margin="16" Spacing="12">
        <!-- Pipeline Selector -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="Pipeline" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <UniformGrid Columns="4" Rows="1">
                    <Button Content="SD 1.5" Padding="16,6" Margin="0,0,4,0" x:Name="Sd15Button" Click="OnPipelineSelected"/>
                    <Button Content="SDXL" Padding="16,6" Margin="0,0,4,0" x:Name="SdxlButton" Click="OnPipelineSelected"/>
                    <Button Content="SD 3" Padding="16,6" Margin="0,0,4,0" x:Name="Sd3Button" Click="OnPipelineSelected"/>
                    <Button Content="Flux" Padding="16,6" x:Name="FluxButton" Click="OnPipelineSelected"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Mode Tabs -->
        <StackPanel>
            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,8">
                <Button Content="🎨 Generate" Padding="16,8" Margin="0,0,4,0" x:Name="GenerateButton" Click="OnGenerate"/>
                <Button Content="📷 Image→Image" Padding="16,8" Margin="0,0,4,0" x:Name="Image2ImageButton" Click="OnImage2Image"/>
                <Button Content="🖼 Inpaint" Padding="16,8" Margin="0,0,4,0" x:Name="InpaintButton" Click="OnInpaint"/>
                <Button Content="🔁 Variation" Padding="16,8" x:Name="VariationButton" Click="OnVariation"/>
            </UniformGrid>
        </StackPanel>

        <!-- Prompt -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="Prompt" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="PromptTextBox" Height="80" Background="Transparent" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" BorderThickness="0"/>
                <TextBlock Text="Negative Prompt" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,4"/>
                <TextBox x:Name="NegativePromptTextBox" Height="50" Background="Transparent" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Image Input (for Image→Image) -->
        <Border x:Name="ImageInputBorder" Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12" IsVisible="False">
            <StackPanel>
                <TextBlock Text="Input Image" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <Border x:Name="ImagePreviewBorder" Background="{StaticResource BgTertiary}" CornerRadius="4" MinHeight="200" MaxHeight="400">
                    <Image x:Name="ImagePreview" Stretch="Uniform" Margin="8"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Denoise:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                    <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="1" Value="0.75" Width="200" Margin="8,0" ValueChanged="OnDenoiseChanged"/>
                    <TextBlock x:Name="DenoiseValue" Text="0.75" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Width="40"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Parameters -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="Parameters" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <UniformGrid Columns="3" Rows="1">
                    <StackPanel>
                        <TextBlock Text="Width" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="WidthTextBox" Text="1024" Width="80" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Height" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="HeightTextBox" Text="1024" Width="80" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Steps" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="StepsTextBox" Text="30" Width="80" Margin="0,4,0,0"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Rows="1" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="CFG Scale" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="CfgTextBox" Text="7.5" Width="80" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Seed" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="SeedTextBox" Text="-1" Width="80" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Sampler" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <ComboBox x:Name="SamplerComboBox" SelectedIndex="0" Width="100" Margin="0,4,0,0">
                            <ComboBoxItem Content="Euler"/>
                            <ComboBoxItem Content="Euler A"/>
                            <ComboBoxItem Content="DPM++"/>
                            <ComboBoxItem Content="LMS"/>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Presets:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                    <Button Content="512²" Padding="8,4" Margin="0,0,4,0" Click="OnPresetSelected"/>
                    <Button Content="768²" Padding="8,4" Margin="0,0,4,0" Click="OnPresetSelected"/>
                    <Button Content="1024²" Padding="8,4" Margin="0,0,4,0" Click="OnPresetSelected"/>
                    <Button Content="1344²" Padding="8,4" Click="OnPresetSelected"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- LoRA Adapters -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="LoRA Adapters" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <Button Content="+ Add" Padding="8,4" Margin="8,0,0,0" x:Name="AddLoraButton" Click="OnAddLora"/>
                    <Button Content="Clear All" Padding="8,4" Margin="4,0,0,0" x:Name="ClearLoraButton" Click="OnClearLora"/>
                </StackPanel>
                <ItemsControl x:Name="LoraList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LoraViewModel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                                <Slider Width="100" Minimum="0" Maximum="2" Value="{Binding Weight}" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Weight, StringFormat={}{0:F1}}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Width="30"/>
                                <Button Content="✕" Padding="4,0" Margin="8,0,0,0" Click="OnRemoveLora"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Output -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Output" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <ComboBox x:Name="OutputFormatComboBox" Width="100" Margin="8,0">
                        <ComboBoxItem Content="PNG"/>
                        <ComboBoxItem Content="JPEG"/>
                        <ComboBoxItem Content="WebP"/>
                        <ComboBoxItem Content="ICO"/>
                        <ComboBoxItem Content="BMP"/>
                        <ComboBoxItem Content="GIF"/>
                    </ComboBox>
                    <TextBox x:Name="OutputPathTextBox" Text="C:\Users\Pictures\OpenLMStudio" Width="250" Margin="8,0,0,0"/>
                    <Button Content="Browse" Padding="8,4" Margin="4,0,0,0" x:Name="BrowseOutputButton" Click="OnBrowseOutput"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="▶ Generate" Padding="16,8" Background="{StaticResource AccentGreen}" Foreground="White" x:Name="GenerateButton2" Click="OnGenerate"/>
                    <Button Content="⏸ Pause" Padding="12,8" Margin="4,0,0,0" x:Name="PauseButton"/>
                    <Button Content="⏹ Stop" Padding="12,8" Margin="4,0,0,0" x:Name="StopButton"/>
                </StackPanel>
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="4" Margin="0,8,0,0"/>
                <TextBlock x:Name="ProgressText" Text="0%" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Preview -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <Border x:Name="PreviewBorder" Background="{StaticResource BgTertiary}" CornerRadius="4" MinHeight="300" MaxHeight="500">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Recent -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Recent" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <Button Content="View All →" Padding="8,4" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
                <ItemsControl x:Name="RecentImages" Height="100">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="80" Height="80" Margin="4" Background="{StaticResource BgTertiary}" CornerRadius="4">
                                <Image Stretch="Uniform"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>