<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenLMStudio.Desktop.Controls.ImageGenerationTab"
             x:Name="Root"
             xmlns:local="clr-namespace:OpenLMStudio.Desktop.Controls"
             xmlns:app="clr-namespace:OpenLMStudio.Application.Types;assembly=OpenLMStudio.Application">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="TextMuted" Color="#666666"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9800"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="ModelLoaded" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ModelLoading" Color="#FF9800"/>
        <SolidColorBrush x:Key="ModelUnloaded" Color="#757575"/>
    </UserControl.Resources>

    <!-- Compact layout for 280x320 sidebar -->
    <Grid Margin="6" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <!-- Row 0: Model Selector (with status light) -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6" Margin="0,0,0,3">
            <StackPanel>
                <!-- Header row with status light -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Model" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="6,0,0,0" Fill="{Binding ModelStatusColor, ElementName=Root}">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Setter Property="Stroke" Value="{StaticResource BgTertiary}"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                            </Style>
                        </Ellipse.Styles>
                    </Ellipse>
                    <TextBlock x:Name="ModelStatusText" Text=" Unloaded" FontSize="9" Foreground="{StaticResource TextSecondary}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="⟳" Padding="3,0" Margin="4,0,0,0" x:Name="RefreshModelButton" Click="OnRefreshModels" FontSize="9" ToolTip.Tip="Refresh model list"/>
                </StackPanel>

                <!-- Model dropdown + Load/Unload -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModelComboBox" Grid.Column="0" Height="22" Margin="0,0,3,0" FontSize="10" SelectionChanged="OnModelSelected"
                              ToolTip.Tip="Select a diffusion model for generation">
                        <ComboBoxItem Content="— Select Model —"/>
                    </ComboBox>
                    <Button Content="Load" Grid.Column="1" Padding="6,2" Margin="3,0,2,0" x:Name="LoadModelButton" Click="OnLoadModel" FontSize="9" Background="{StaticResource AccentGreen}" Foreground="White" CornerRadius="3" ToolTip.Tip="Load model into memory"/>
                    <Button Content="Unload" Grid.Column="2" Padding="6,2" x:Name="UnloadModelButton" Click="OnUnloadModel" FontSize="9" Background="{StaticResource AccentRed}" Foreground="White" CornerRadius="3" ToolTip.Tip="Unload model from memory"/>
                </Grid>

                <!-- VRAM indicator -->
                <StackPanel Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VRAM" FontSize="8" Foreground="{StaticResource TextMuted}" Grid.Column="0"/>
                        <ProgressBar x:Name="VramBar" Grid.Column="1" Height="3" Margin="4,0" Minimum="0" Maximum="100" Value="0" CornerRadius="2" Background="{StaticResource BgTertiary}"/>
                        <TextBlock x:Name="VramText" Text="0 / 0 GB" FontSize="8" Foreground="{StaticResource TextMuted}" Grid.Column="2" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Model info -->
                <TextBlock x:Name="ModelInfoText" Text="Select a model to begin" FontSize="8" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Row 1: Mode Tabs (🎨📷🖼🔁) -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="3" Margin="0,0,0,3">
            <UniformGrid Columns="4" Rows="1">
                <Button Content="🎨" Padding="4,2" Margin="0,0,1,0" x:Name="GenerateButton" Click="OnGenerate" FontSize="12" Background="{StaticResource AccentBlue}" CornerRadius="4" ToolTip.Tip="Text-to-image"/>
                <Button Content="📷" Padding="4,2" Margin="0,0,1,0" x:Name="Image2ImageButton" Click="OnImage2Image" FontSize="12" Background="{StaticResource BgTertiary}" CornerRadius="4" ToolTip.Tip="Image-to-image"/>
                <Button Content="🖼" Padding="4,2" Margin="0,0,1,0" x:Name="InpaintButton" Click="OnInpaint" FontSize="12" Background="{StaticResource BgTertiary}" CornerRadius="4" ToolTip.Tip="Inpaint"/>
                <Button Content="🔁" Padding="4,2" x:Name="VariationButton" Click="OnVariation" FontSize="12" Background="{StaticResource BgTertiary}" CornerRadius="4" ToolTip.Tip="Variation"/>
            </UniformGrid>
        </Border>

        <!-- Row 2: Prompt -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="5" Margin="0,0,0,3">
            <StackPanel>
                <TextBlock Text="Prompt" FontSize="9" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,1"/>
                <TextBox x:Name="PromptTextBox" Height="32" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}"
                         TextWrapping="Wrap" BorderThickness="0" Padding="3,2" FontSize="9"/>
                <TextBlock Text="Negative" FontSize="8" Foreground="{StaticResource TextMuted}" Margin="0,3,0,1"/>
                <TextBox x:Name="NegativePromptTextBox" Height="20" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextSecondary}"
                         TextWrapping="Wrap" BorderThickness="0" Padding="3,1" FontSize="8"/>
            </StackPanel>
        </Border>

        <!-- Row 3: Parameters -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="5" Margin="0,0,0,3">
            <StackPanel>
                <TextBlock Text="Parameters" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,2,0">
                        <TextBlock Text="W" FontSize="8" Foreground="{StaticResource TextMuted}"/>
                        <TextBox x:Name="WidthTextBox" Text="1024" Width="45" Margin="0,0,0,0" FontSize="9" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="2,0,2,0">
                        <TextBlock Text="H" FontSize="8" Foreground="{StaticResource TextMuted}"/>
                        <TextBox x:Name="HeightTextBox" Text="1024" Width="45" Margin="0,0,0,0" FontSize="9" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="2,0,2,0">
                        <TextBlock Text="Steps" FontSize="8" Foreground="{StaticResource TextMuted}"/>
                        <TextBox x:Name="StepsTextBox" Text="30" Width="45" Margin="0,0,0,0" FontSize="9" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="2,0,0,0">
                        <TextBlock Text="CFG" FontSize="8" Foreground="{StaticResource TextMuted}"/>
                        <TextBox x:Name="CfgTextBox" Text="7.5" Width="45" Margin="0,0,0,0" FontSize="9" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,2,2,0">
                        <TextBlock Text="Seed" FontSize="8" Foreground="{StaticResource TextMuted}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SeedTextBox" Text="-1" Width="35" Margin="0,0,0,0" FontSize="9" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}" Grid.Column="0"/>
                            <Button Content="🎲" Padding="1,0" Grid.Column="1" Click="OnRandomizeSeed" FontSize="8" ToolTip.Tip="Randomize"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="2,2,0,0">
                        <TextBlock Text="Sampler" FontSize="8" Foreground="{StaticResource TextMuted}"/>
                        <ComboBox x:Name="SamplerComboBox" SelectedIndex="0" Width="55" Margin="0,0,0,0" FontSize="9" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextPrimary}">
                            <ComboBoxItem Content="Euler"/>
                            <ComboBoxItem Content="Euler A"/>
                            <ComboBoxItem Content="DPM++ 2M"/>
                            <ComboBoxItem Content="DPM++ SDE"/>
                            <ComboBoxItem Content="Heun"/>
                            <ComboBoxItem Content="LMS"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="P:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,0,2,0"/>
                        <Button Content="512" Padding="2,0" Margin="0,0,2,0" Click="OnPresetSelected" FontSize="8" ToolTip.Tip="512²"/>
                        <Button Content="768" Padding="2,0" Margin="0,0,2,0" Click="OnPresetSelected" FontSize="8" ToolTip.Tip="768²"/>
                        <Button Content="1024" Padding="2,0" Margin="0,0,2,0" Click="OnPresetSelected" FontSize="8" ToolTip.Tip="1024²"/>
                        <Button Content="1344" Padding="2,0" Click="OnPresetSelected" FontSize="8" ToolTip.Tip="1344²"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 4: LoRA Adapters -->
        <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="5" Margin="0,0,0,3">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="LoRA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <Button Content="+" Padding="2,0" Margin="3,0,0,0" x:Name="AddLoraButton" Click="OnAddLora" FontSize="9" ToolTip.Tip="Add LoRA"/>
                    <Button Content="Clear" Padding="2,0" Margin="2,0,0,0" x:Name="ClearLoraButton" Click="OnClearLora" FontSize="9" ToolTip.Tip="Clear all"/>
                </StackPanel>
                <ItemsControl x:Name="LoraList" MaxHeight="45">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LoraViewModel">
                            <Border Width="90" Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="2" Margin="0,0,2,2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" MaxWidth="75" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="8" Foreground="{StaticResource TextPrimary}" ToolTip.Tip="{Binding Name}"/>
                                    <Slider Width="80" Minimum="0" Maximum="2" Value="{Binding Weight}" Margin="0,1,0,0" FontSize="8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="{Binding Weight, StringFormat={}{0:F1}}" FontSize="8" Foreground="{StaticResource TextSecondary}" Width="18"/>
                                        <Button Content="✕" Padding="1,0" Margin="2,0,0,0" Click="OnRemoveLora" FontSize="8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Row 5: Output & Generate -->
        <Border Grid.Row="5" Grid.ColumnSpan="2" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="5" Margin="0,0,0,3">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Format" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                    <ComboBox x:Name="OutputFormatComboBox" Width="45" Margin="3,0" FontSize="8">
                        <ComboBoxItem Content="PNG"/>
                        <ComboBoxItem Content="JPG"/>
                        <ComboBoxItem Content="WebP"/>
                        <ComboBoxItem Content="ICO"/>
                        <ComboBoxItem Content="BMP"/>
                        <ComboBoxItem Content="GIF"/>
                    </ComboBox>
                    <TextBox x:Name="OutputPathTextBox" Text="~/Pictures/OpenLMStudio" Width="70" Margin="3,0,0,0" FontSize="8" Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextSecondary}"/>
                    <Button Content="…" Padding="3,0" x:Name="BrowseOutputButton" Click="OnBrowseOutput" FontSize="8" ToolTip.Tip="Browse"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <Button Content="▶ Generate" Padding="10,3" Background="{StaticResource AccentGreen}" Foreground="White" FontWeight="SemiBold"
                            x:Name="GenerateButton2" Click="OnGenerate" FontSize="10" ToolTip.Tip="Generate image"/>
                    <Button Content="⏸" Padding="4,3" Margin="2,0,0,0" x:Name="PauseButton" IsEnabled="False" ToolTip.Tip="Pause"/>
                    <Button Content="⏹" Padding="4,3" Margin="2,0,0,0" x:Name="StopButton" Click="OnStop" FontSize="10" ToolTip.Tip="Stop"/>
                </StackPanel>
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="3" Margin="0,2,0,0" CornerRadius="2" Background="{StaticResource BgTertiary}"/>
                <TextBlock x:Name="ProgressText" Text="Ready" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,1,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 6: Preview -->
        <Border Grid.Row="6" Grid.ColumnSpan="2" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="5" Margin="0,0,0,3">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Preview" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <Button Content="💾" Padding="3,0" Margin="4,0,0,0" x:Name="SaveButton" Click="OnSaveImage" FontSize="9" ToolTip.Tip="Save"/>
                    <Button Content="📋" Padding="3,0" Margin="2,0,0,0" x:Name="CopyButton" Click="OnCopyImage" FontSize="9" ToolTip.Tip="Copy"/>
                </StackPanel>
                <Border x:Name="PreviewBorder" Background="{StaticResource BgTertiary}" CornerRadius="4" MinHeight="40" MaxHeight="80">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="2"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Row 7: Recent -->
        <Border Grid.Row="7" Grid.ColumnSpan="2" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Recent" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <Button Content="→" Padding="2,0" Margin="3,0,0,0" Click="OnViewGallery" FontSize="9" ToolTip.Tip="Gallery"/>
                </StackPanel>
                <ItemsControl x:Name="RecentImages" MaxHeight="40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:ImageGalleryEntry">
                            <Border Width="38" Height="38" Margin="2" Background="{StaticResource BgTertiary}" CornerRadius="3">
                                <Image Stretch="Uniform" Source="{Binding ThumbnailPath}" ToolTip.Tip="{Binding Prompt}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>