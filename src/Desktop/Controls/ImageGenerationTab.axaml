<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenLMStudio.Desktop.Controls.ImageGenerationTab"
             xmlns:local="clr-namespace:OpenLMStudio.Desktop.Controls">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#252529"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9800"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
    </UserControl.Resources>

    <!-- Fixed height layout for sidebar (280x400) — no scrolling -->
    <StackPanel Margin="6" Spacing="6" MaxWidth="280">

        <!-- Pipeline Selector -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6">
            <StackPanel>
                <TextBlock Text="Pipeline" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,3"/>
                <UniformGrid Columns="4" Rows="1">
                    <Button Content="SD1.5" Padding="3,3" Margin="0,0,2,0" x:Name="Sd15Button" Click="OnPipelineSelected" FontSize="10"/>
                    <Button Content="SDXL" Padding="3,3" Margin="0,0,2,0" x:Name="SdxlButton" Click="OnPipelineSelected" FontSize="10"/>
                    <Button Content="SD3" Padding="3,3" Margin="0,0,2,0" x:Name="Sd3Button" Click="OnPipelineSelected" FontSize="10"/>
                    <Button Content="Flux" Padding="3,3" x:Name="FluxButton" Click="OnPipelineSelected" FontSize="10"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Mode Tabs -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6">
            <UniformGrid Columns="4" Rows="1">
                <Button Content="🎨" Padding="4,3" Margin="0,0,1,0" x:Name="GenerateButton" Click="OnGenerate" FontSize="12"/>
                <Button Content="📷" Padding="4,3" Margin="0,0,1,0" x:Name="Image2ImageButton" Click="OnImage2Image" FontSize="12"/>
                <Button Content="🖼" Padding="4,3" Margin="0,0,1,0" x:Name="InpaintButton" Click="OnInpaint" FontSize="12"/>
                <Button Content="🔁" Padding="4,3" x:Name="VariationButton" Click="OnVariation" FontSize="12"/>
            </UniformGrid>
        </Border>

        <!-- Prompt -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6">
            <StackPanel>
                <TextBlock Text="Prompt" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                <TextBox x:Name="PromptTextBox" Height="40" Background="Transparent" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" BorderThickness="0" Padding="3" FontSize="10"/>
                <TextBlock Text="Negative Prompt" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,2"/>
                <TextBox x:Name="NegativePromptTextBox" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" BorderThickness="0" Padding="3" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- Image Input (for Image→Image) -->
        <Border x:Name="ImageInputBorder" Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6" IsVisible="False">
            <StackPanel>
                <TextBlock Text="Input Image" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                <Border x:Name="ImagePreviewBorder" Background="{StaticResource BgTertiary}" CornerRadius="4" MinHeight="50" MaxHeight="100">
                    <Image x:Name="ImagePreview" Stretch="Uniform" Margin="3"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Denoise:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                    <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="1" Value="0.75" Width="90" Margin="3,0" ValueChanged="OnDenoiseChanged"/>
                    <TextBlock x:Name="DenoiseValue" Text="0.75" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="10" Width="24"/>
                </StackPanel>
                <Button Content="📁 Load" Padding="3,2" Margin="0,3,0,0" Click="OnLoadImage" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- Parameters -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6">
            <StackPanel>
                <TextBlock Text="Parameters" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,3"/>
                <UniformGrid Columns="2" Rows="1">
                    <StackPanel>
                        <TextBlock Text="W" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="WidthTextBox" Text="1024" Width="50" Margin="0,1,0,0" FontSize="10"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="H" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="HeightTextBox" Text="1024" Width="50" Margin="0,1,0,0" FontSize="10"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2" Rows="1" Margin="0,3,0,0">
                    <StackPanel>
                        <TextBlock Text="Steps" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="StepsTextBox" Text="30" Width="50" Margin="0,1,0,0" FontSize="10"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CFG" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="CfgTextBox" Text="7.5" Width="50" Margin="0,1,0,0" FontSize="10"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2" Rows="1" Margin="0,3,0,0">
                    <StackPanel>
                        <TextBlock Text="Seed" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox x:Name="SeedTextBox" Text="-1" Width="50" Margin="0,1,0,0" FontSize="10"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Sampler" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                        <ComboBox x:Name="SamplerComboBox" SelectedIndex="0" Width="70" Margin="0,1,0,0" FontSize="10">
                            <ComboBoxItem Content="Euler"/>
                            <ComboBoxItem Content="Euler A"/>
                            <ComboBoxItem Content="DPM++"/>
                            <ComboBoxItem Content="LMS"/>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="P:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,0,3,0"/>
                    <Button Content="512" Padding="3,1" Margin="0,0,2,0" Click="OnPresetSelected" FontSize="9"/>
                    <Button Content="768" Padding="3,1" Margin="0,0,2,0" Click="OnPresetSelected" FontSize="9"/>
                    <Button Content="1024" Padding="3,1" Margin="0,0,2,0" Click="OnPresetSelected" FontSize="9"/>
                    <Button Content="1344" Padding="3,1" Click="OnPresetSelected" FontSize="9"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- LoRA Adapters -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="LoRA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <Button Content="+" Padding="3,1" Margin="3,0,0,0" x:Name="AddLoraButton" Click="OnAddLora" FontSize="10"/>
                    <Button Content="C" Padding="3,1" Margin="2,0,0,0" x:Name="ClearLoraButton" Click="OnClearLora" FontSize="10"/>
                </StackPanel>
                <ItemsControl x:Name="LoraList" MaxHeight="50">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LoraViewModel">
                            <Border Width="100" Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="3" Margin="0,0,3,3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" MaxWidth="80" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="9" Foreground="{StaticResource TextPrimary}"/>
                                    <Slider Width="90" Minimum="0" Maximum="2" Value="{Binding Weight}" Margin="0,1,0,0" FontSize="9"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding Weight, StringFormat={}{0:F1}}" FontSize="9" Foreground="{StaticResource TextSecondary}" Width="20"/>
                                        <Button Content="✕" Padding="1,0" Margin="3,0,0,0" Click="OnRemoveLora" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Output & Generate -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="Format" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <ComboBox x:Name="OutputFormatComboBox" Width="50" Margin="3,0" FontSize="10">
                        <ComboBoxItem Content="PNG"/>
                        <ComboBoxItem Content="JPG"/>
                        <ComboBoxItem Content="WebP"/>
                        <ComboBoxItem Content="ICO"/>
                        <ComboBoxItem Content="BMP"/>
                        <ComboBoxItem Content="GIF"/>
                    </ComboBox>
                    <TextBox x:Name="OutputPathTextBox" Text="~/Pictures/OpenLMStudio" Width="*" Margin="3,0,0,0" FontSize="10"/>
                    <Button Content="…" Padding="4,1" x:Name="BrowseOutputButton" Click="OnBrowseOutput" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Content="▶" Padding="10,3" Background="{StaticResource AccentGreen}" Foreground="White" x:Name="GenerateButton2" Click="OnGenerate" FontSize="11"/>
                    <Button Content="⏸" Padding="6,3" Margin="3,0,0,0" x:Name="PauseButton" FontSize="11"/>
                    <Button Content="⏹" Padding="6,3" Margin="2,0,0,0" x:Name="StopButton" Click="OnStop" FontSize="11"/>
                </StackPanel>
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="3" Margin="0,3,0,0"/>
                <TextBlock x:Name="ProgressText" Text="0%" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Preview -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6">
            <StackPanel>
                <TextBlock Text="Preview" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,3"/>
                <Border x:Name="PreviewBorder" Background="{StaticResource BgTertiary}" CornerRadius="4" MinHeight="60" MaxHeight="120">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="3"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Recent -->
        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="Recent" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <Button Content="→" Padding="3,0" Margin="3,0,0,0" FontSize="10"/>
                </StackPanel>
                <ItemsControl x:Name="RecentImages" MaxHeight="60">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="45" Height="45" Margin="2" Background="{StaticResource BgTertiary}" CornerRadius="3">
                                <Image Stretch="Uniform" Source="{Binding ThumbnailPath}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
