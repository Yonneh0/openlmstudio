<UserControl x:Class="OpenLMStudio.Desktop.Controls.VMPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400" Height="500">

    <StackPanel>
        <!-- VM list -->
        <ListBox x:Name="VmList"
                 Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Width="100"/>
                        <TextBlock Text="{Binding Status}" Width="80"/>
                        <TextBlock Text="{Binding Architecture}" Width="60"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- VM controls -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Start"
                    Margin="0,0,4,0"/>
            <Button Content="Stop"
                    Margin="0,0,4,0"/>
            <Button Content="Pause"
                    Margin="0,0,4,0"/>
            <Button Content="Resume"
                    Margin="0,0,4,0"/>
        </StackPanel>

        <!-- VM console -->
        <ScrollViewer>
            <TextBox x:Name="VmConsoleOutput"
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="Consolas, 'Courier New', monospace"/>
        </ScrollViewer>
    </StackPanel>
</UserControl>