<UserControl x:Class="OpenLMStudio.Desktop.Controls.VMWizardStep2"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Step 2 of 5: Hardware Configuration"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- CPU Cores -->
        <TextBlock Text="CPU Cores:" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Slider x:Name="CpuSlider"
                Minimum="1" Maximum="32" Value="2"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Margin="0,0,0,4"/>
        <TextBlock x:Name="CpuValueText"
                   Text="2 cores"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="#666"
                   Margin="0,0,0,16"/>

        <!-- RAM -->
        <TextBlock Text="RAM (MB):" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Slider x:Name="RamSlider"
                Minimum="256" Maximum="32768" Value="2048"
                TickFrequency="256" IsSnapToTickEnabled="True"
                Margin="0,0,0,4"/>
        <TextBlock x:Name="RamValueText"
                   Text="2048 MB"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="#666"
                   Margin="0,0,0,16"/>

        <!-- Disk Size -->
        <TextBlock Text="Disk Size (GB):" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Slider x:Name="DiskSlider"
                Minimum="1" Maximum="500" Value="20"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Margin="0,0,0,4"/>
        <TextBlock x:Name="DiskValueText"
                   Text="20 GB"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="#666"
                   Margin="0,0,0,16"/>
    </StackPanel>
</UserControl>