<UserControl x:Class="OpenLMStudio.Desktop.Controls.VMWizardStep5"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Step 5 of 5: Review and Create"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <TextBox x:Name="ReviewText"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, 'Courier New', monospace"
                 FontSize="12"
                 Background="#FFF"
                 Padding="12"
                 BorderBrush="#DDD"
                 BorderThickness="1"
                 IsReadOnly="True"/>
    </StackPanel>
</UserControl>